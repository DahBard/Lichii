+    /// Calls func(begin, end) over [0, count) in chunks; returns once every chunk is done.
+    void Run(u32 count, const std::function<void(u32, u32)>& func) {
+        std::unique_lock busy{run_mutex, std::try_to_lock};
+        if (!busy || workers.empty()) {
