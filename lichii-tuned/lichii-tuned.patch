+               : fs.back_regs[method] != 0 ? regs.reg_array[method]
+                                           : fs.regs[method];
+    };
+    const auto entry_of = [&](u32 method) {
+        const auto it = entries.find(method);
+        return it != entries.end()           ? it->second
+               : fs.back_shadow[method] != 0 ? shadow_state.reg_array[method]
+                                             : fs.shadow[method];
