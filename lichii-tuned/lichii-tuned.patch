+            std::scoped_lock ql{wait_queue_mutex};
+            dropped.swap(wait_queue);
+        }
+        for (const PendingWait& item : dropped) {
+            ReportShown(item.id, std::chrono::steady_clock::now(), true);
+        }
+    }
