+    split.Publish();
+    REQUIRE(wait_until([&] { return entered.load(); }));
+    split.RequestTick();
+    std::this_thread::sleep_for(std::chrono::milliseconds{5});
+    REQUIRE(ticks.load() == 1);
+    release = true;
+    split.Drain(VideoCommon::DrainSite::Other);
+    REQUIRE(ticks_at_second == 2);
+    REQUIRE(ticks.load() == 2);
