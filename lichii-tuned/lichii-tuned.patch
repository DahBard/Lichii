+    constexpr GPUVAddr words = MappedPages::gpu_address + 0x1000;
+    constexpr DAddr word_devices = MappedPages::device_address + 0x1000;
+    Fixture f;
+    f.system.Initialize();
+    Tegra::Nx2ClearGpuWrittenPages();
+    MappedPages pages{f};
+    Tegra::Engines::KeplerCompute compute{f.memory};
+    Tegra::MacroEngine macros{true};
+    std::array<u32, 128> positions{};
+    compute.SetNativeMacroMode(&macros, positions);
+    compute.BindRasterizer(&f.rasterizer);
+    VideoCommon::GpuSplit split;
+    Access::Initialize(split, f.system);
+    const auto send = [&](u32 method, u32 argument) {
+        compute.FrontCallMethod(f.system, split, method, argument, true, nullptr);
+    };
+    const auto make_qmd = [](u32 dependencies, u32 word_offset, u32 flags, u32 payload) {
+        Descriptor qmd{};
+        qmd[18] = 0x30;
+        qmd[4] = dependencies << 14;
+        qmd[24] = static_cast<u32>(words) + word_offset;
+        qmd[25] = flags;
+        qmd[26] = payload;
+        return qmd;
+    };
+    // An inline QMD, in memory already (the null rasterizer's inline writes write nothing): its
+    // words but the last, then, after the back ran them when `caught_up`, the last.
+    const auto inline_qmd = [&](GPUVAddr address, const Descriptor& qmd, bool caught_up) {
+        std::memcpy(pages.backing + (address - MappedPages::gpu_address), qmd.data(), sizeof(qmd));
+        send(0xc6, static_cast<u32>((address >> 8) >> 32));
+        send(0xc7, static_cast<u32>(address >> 8));
+        for (u32 i = 0; i < 63; ++i) {
+            send(0xc8 + i, qmd[i]);
+        }
+        if (caught_up) {
+            Access::RunBack(split);
+        }
+        send(0x107, qmd[63]);
+    };
+    const auto word = [&](u32 offset) { return f.memory.Read<u32>(words + offset); };
+    const auto queued = [&](u32 offset) {
+        return split.QueuedSemaphoreWriteAt(word_devices + offset);
+    };
+
+    // A QMD that runs at once: its release is the front's once its table is the back's, which it
+    // takes over when the back has run everything sent.
+    inline_qmd(qmds, make_qmd(0, 0, Enable | OneWord, 5), true);
+    auto release = queued(0);
+    REQUIRE(release.has_value());
+    CHECK(release->known);
+    CHECK_FALSE(release->at_least);
+    CHECK(release->payload == 5);
+    Access::RunBack(split);
+
+    // One that waits for a dependency runs at the decrement, a maximum with the word in memory.
+    f.memory.Write<u32>(words + 0x10, 9);
+    inline_qmd(qmds + 0x100, make_qmd(1, 0x10, Enable | OneWord | Maximum, 7), false);
+    CHECK_FALSE(queued(0x10).has_value());
+    send(0xad, static_cast<u32>((qmds + 0x100) >> 8));
+    Access::RunBack(split);
+    send(0xb0, 7);
+    release = queued(0x10);
+    REQUIRE(release.has_value());
+    CHECK(release->known);
+    CHECK_FALSE(release->at_least);
+    CHECK(release->payload == 9);
+    Access::RunBack(split);
+    CHECK(word(0x10) == 9);
+
+    // Over a value the front can't tell, a maximum holds its payload at least.
+    split.Defer([] {}, Writes::Noted);
+    split.NoteSemaphoreWrite(word_devices + 0x10, 0, false);
+    inline_qmd(qmds + 0x200, make_qmd(0, 0x10, Enable | OneWord | Maximum, 12), false);
+    release = queued(0x10);
+    REQUIRE(release.has_value());
+    CHECK(release->known);
+    CHECK(release->at_least);
+    CHECK(release->payload == 12);
+    Access::RunBack(split);
+    CHECK(word(0x10) == 12);
+
+    // A reduction over the release before it, still queued.
+    inline_qmd(qmds + 0x300, make_qmd(0, 0x20, Enable | OneWord | Maximum, 4), false);
+    inline_qmd(qmds + 0x400, make_qmd(0, 0x20, Enable | OneWord | Reduction, 3), false);
+    release = queued(0x20);
+    REQUIRE(release.has_value());
+    CHECK(release->known);
+    CHECK_FALSE(release->at_least);
+    CHECK(release->payload == 7);
+    Access::RunBack(split);
+    CHECK(word(0x20) == 7);
+
+    // Work that may write guest memory anywhere and change the mappings, still queued: the front
+    // can't tell what the back reads yet, the launch waits for it.
+    split.Defer([] {});
+    inline_qmd(qmds + 0x500, make_qmd(0, 0x30, Enable | OneWord, 1), false);
+    CHECK_FALSE(queued(0x30).has_value());
+    Access::RunBack(split);
+    // The back ran everything: the front takes its table over, the waiting launch with it.
+    inline_qmd(qmds + 0x600, make_qmd(0, 0x30, Enable | OneWord, 2), true);
+    release = queued(0x30);
+    REQUIRE(release.has_value());
+    CHECK(release->payload == 2);
+    Access::RunBack(split);
+
+    // A write to a waiting QMD still queued when its decrement is sent: the launch waits, not
+    // valued then.
+    inline_qmd(qmds + 0x700, make_qmd(1, 0x40, Enable | OneWord | Maximum, 3), false);
+    Access::RunBack(split);
+    split.Defer([] {}, Writes::Noted);
+    split.NoteWrite(f.memory, qmds + 0x700 + 26 * sizeof(u32), sizeof(u32));
+    send(0xad, static_cast<u32>((qmds + 0x700) >> 8));
+    send(0xb0, 7);
+    CHECK_FALSE(queued(0x40).has_value());
+    Access::RunBack(split);
+    CHECK(word(0x40) == 3);
+}
diff --git a/src/tests/video_core/native_qmd.cpp b/src/tests/video_core/native_qmd.cpp
index 560ae4b13..2a7943a01 100644
--- a/src/tests/video_core/native_qmd.cpp
+++ b/src/tests/video_core/native_qmd.cpp
@@ -4,7 +4,9 @@
 #include <array>
 #include <cstdint>
 #include <map>
+#include <string>
 #include <string_view>
+#include <utility>
 #include <vector>
 
 #include <catch2/catch_test_macros.hpp>
@@ -149,3 +151,141 @@ TEST_CASE("Semaphore reductions follow the documented ops", "[video_core][native
     REQUIRE(ReduceSemaphore(6, false, 0b1100, 0b1010) == 0b1110);
     REQUIRE(ReduceSemaphore(7, false, 0b1100, 0b1010) == 0b0110);
 }
+
+TEST_CASE("A QMD scheduler with a table of its own schedules apart from the shared one",
+          "[video_core][native_qmd]") {
+    constexpr Address address = 0x40000;
+    auto qmd = MakeQmd();
+    qmd[4] = 1U << 14; // One dependency
+    SetRelease(qmd, 24, 0x5000, Enable | OneWord, 1);
+    const std::map<Address, Descriptor> memory{{address, qmd}};
+    const auto signal = [&](NativeQmdScheduler& scheduler, Word action) {
+        std::vector<Released> released;
+        const auto error = scheduler.Signal(
+            address, action,
+            [&](Address qmd_address, Descriptor& descriptor) {
+                const auto it = memory.find(qmd_address);
+                if (it == memory.end()) {
+                    return false;
+                }
+                descriptor = it->second;
+                return true;
+            },
+            [&](Address destination, Word payload, Word flags) {
+                released.push_back({destination, payload, flags});
+                return true;
+            });
+        REQUIRE(error.empty());
+        return released;
+    };
+    const std::vector<Released> run{{0x5000, 1, Enable | OneWord}};
+    // Loaded on the shared table, it waits for its dependency.
+    NativeQmdScheduler shared;
+    REQUIRE(signal(shared, 3).empty());
+    // A copy of the table runs it at the decrement as the shared one does, and apart from it.
+    NativeQmdScheduler own{NativeQmdScheduler::OwnTable{}};
+    own.CopyStates(shared);
+    REQUIRE(signal(own, 7) == run);
+    REQUIRE(signal(own, 7).empty()); // Completed: a decrement is kept for its next load
+    REQUIRE(signal(shared, 7) == run);
+    // A table that never saw the load keeps the decrement for it.
+    NativeQmdScheduler other{NativeQmdScheduler::OwnTable{}};
+    REQUIRE(signal(other, 7).empty());
+    REQUIRE(signal(other, 3) == run);
+}
+
+TEST_CASE("A QMD scheduler takes back what an attempt changed and keeps what one committed",
+          "[video_core][native_qmd]") {
+    constexpr Address first = 0x40000;
+    constexpr Address second = 0x40100;
+    auto waiting = MakeQmd();
+    waiting[4] = 1U << 14; // One dependency
+    SetRelease(waiting, 24, 0x5000, Enable | OneWord, 1);
+    auto chained = MakeQmd(); // Decrements `first` when it runs
+    SetRelease(chained, 24, 0x5004, Enable | OneWord, 2);
+    chained[15] = static_cast<Word>(first >> 8);
+    chained[16] = 1 | (4U << 1);
+    std::map<Address, Descriptor> memory{{first, waiting}, {second, chained}};
+    bool unreadable{};
+    const auto signal = [&](NativeQmdScheduler& scheduler, Address address, Word action) {
+        std::vector<Released> released;
+        const auto error = scheduler.Signal(
+            address, action,
+            [&](Address qmd_address, Descriptor& descriptor) {
+                const auto it = memory.find(qmd_address);
+                if (it == memory.end() || (unreadable && qmd_address == first)) {
+                    return false;
+                }
+                descriptor = it->second;
+                return true;
+            },
+            [&](Address destination, Word payload, Word flags) {
+                released.push_back({destination, payload, flags});
+                return true;
+            });
+        return std::make_pair(std::string{error}, released);
+    };
+    NativeQmdScheduler own{NativeQmdScheduler::OwnTable{}};
+    NativeQmdScheduler reference{NativeQmdScheduler::OwnTable{}};
+    REQUIRE(signal(own, first, 3).second.empty()); // Loaded, waits for its dependency
+    REQUIRE(signal(reference, first, 3).second.empty());
+    // The chained launch runs and decrements `first`, which can't be read: taken back, the table
+    // is as before, `second` never ran.
+    unreadable = true;
+    own.BeginAttempt();
+    REQUIRE_FALSE(signal(own, second, 3).first.empty());
+    own.RollbackAttempt();
+    REQUIRE(own.SameStates(reference));
+    REQUIRE(own.StateCount() == 1);
+    // Tried again once it can be read: both run, as on a table that never tried.
+    unreadable = false;
+    own.BeginAttempt();
+    const auto ran = signal(own, second, 3);
+    own.CommitAttempt();
+    const std::vector<Released> both{{0x5004, 2, Enable | OneWord}, {0x5000, 1, Enable | OneWord}};
+    REQUIRE(ran.first.empty());
+    REQUIRE(ran.second == both);
+    REQUIRE(signal(reference, second, 3).second == both);
+    REQUIRE(own.SameStates(reference));
+    // A rollback after the commit changes nothing.
+    own.RollbackAttempt();
+    REQUIRE(own.SameStates(reference));
+}
+
+TEST_CASE("A QMD scheduler takes back the history an attempt dropped at its limit",
+          "[video_core][native_qmd]") {
+    // Any address holds a QMD that runs at once; one of them can't be read.
+    const Descriptor qmd = MakeQmd();
+    Address unreadable = 0;
+    const auto signal = [&](NativeQmdScheduler& scheduler, Address address) {
+        return std::string{scheduler.Signal(
+            address, 3,
+            [&](Address qmd_address, Descriptor& descriptor) {
+                descriptor = qmd;
+                return qmd_address != unreadable;
+            },
+            [](Address, Word, Word) { return true; })};
+    };
+    NativeQmdScheduler own{NativeQmdScheduler::OwnTable{}};
+    NativeQmdScheduler reference{NativeQmdScheduler::OwnTable{}};
+    for (Address i = 0; i < 4096; ++i) {
+        REQUIRE(signal(own, 0x100000 + i * 0x100).empty());
+        REQUIRE(signal(reference, 0x100000 + i * 0x100).empty());
+    }
+    REQUIRE(own.StateCount() == 4096);
+    // A new QMD past the limit drops the finished ones first; it can't be read: all taken back.
+    unreadable = 0x900000;
+    own.BeginAttempt();
+    REQUIRE_FALSE(signal(own, unreadable).empty());
+    own.RollbackAttempt();
+    REQUIRE(own.StateCount() == 4096);
+    REQUIRE(own.SameStates(reference));
+    // Kept, it drops them as the reference does.
+    unreadable = 0;
+    own.BeginAttempt();
+    REQUIRE(signal(own, 0x900000).empty());
+    own.CommitAttempt();
+    REQUIRE(signal(reference, 0x900000).empty());
+    REQUIRE(own.StateCount() == 1);
+    REQUIRE(own.SameStates(reference));
+}
diff --git a/src/tests/video_core/nx2_semaphore_waiters.cpp b/src/tests/video_core/nx2_semaphore_waiters.cpp
