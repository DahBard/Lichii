new file mode 100644
index 0000000..9d76bc2
--- /dev/null
+++ b/src/common/spin_wait.cpp
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <thread>
+
+#include "common/spin_wait.h"
+
+#ifdef ARCHITECTURE_x86_64
+#ifdef _MSC_VER
+#include <intrin.h>
+#endif
+#include <immintrin.h>
+#include "common/cpu_features.h"
+#endif
+
+namespace Common::SpinWait {
+
+#ifdef ARCHITECTURE_x86_64
+
+u64 Now() {
+    return static_cast<u64>(__rdtsc());
+}
+
+void Pause() {
+    _mm_pause();
+}
+
+namespace {
+
+u64 MeasurePauseTicks() {
+    // Skylake-derived Intel cores take ~140 cycles per PAUSE, AMD's far fewer: the spin budgets
+    // in pauses were tuned on one of them, so they are kept as time on this CPU.
+    u64 best = ~u64{0};
+    for (int trial = 0; trial < 5; ++trial) {
+        const u64 start = Now();
+        for (int i = 0; i < 256; ++i) {
+            _mm_pause();
+        }
+        best = (std::min)(best, Now() - start);
+    }
+    return std::clamp<u64>(best / 256, 1, 1000);
+}
+
+} // Anonymous namespace
+
+u64 PauseTicks() {
+    static const u64 ticks = MeasurePauseTicks();
+    return ticks;
+}
+
+u64 TicksPerMicrosecond() {
+    static const u64 ticks = (std::max)(g_cpu_caps.tsc_frequency / 1'000'000, u64{1});
+    return ticks;
+}
+
+// clang and GCC compile the WAITPKG intrinsics into a function marked for it. MSVC builds (the
+// comparison build) spin with PAUSE as before.
+#if defined(__clang__) || defined(__GNUC__)
+#define LICHII_WAITPKG 1
+#else
+#define LICHII_WAITPKG 0
+#endif
+
+bool UsesWaitpkg() {
+    static const bool enabled = [] {
+        const char* const value = std::getenv("LICHII_WAITPKG_SPIN");
+        if (!LICHII_WAITPKG || (value != nullptr && value[0] == '0')) {
+            return false;
+        }
+        return g_cpu_caps.waitpkg && g_cpu_caps.invariant_tsc &&
+               g_cpu_caps.tsc_frequency >= 100'000'000;
+    }();
+    return enabled;
+}
+
+#if LICHII_WAITPKG
+__attribute__((target("waitpkg"))) void Monitor(const void* address) {
+    _umonitor(const_cast<void*>(address));
+}
+
+__attribute__((target("waitpkg"))) void WaitUntil(u64 deadline) {
+    // Control bit 0 set: C0.1, the state with the faster wakeup.
+    _umwait(1, deadline);
+}
+#else
+void Monitor(const void*) {}
+
+void WaitUntil(u64) {}
+#endif
+
+#else
+
+u64 Now() {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count());
+}
+
+void Pause() {
+#if defined(__aarch64__)
+    asm volatile("yield");
+#else
+    std::this_thread::yield();
+#endif
+}
+
+u64 PauseTicks() {
+    return 1;
+}
+
+u64 TicksPerMicrosecond() {
+    return 1000;
+}
+
+bool UsesWaitpkg() {
+    return false;
+}
+
+void Monitor(const void*) {}
+
+void WaitUntil(u64) {}
+
+#endif
+
+} // namespace Common::SpinWait
diff --git a/src/common/spin_wait.h b/src/common/spin_wait.h
new file mode 100644
index 0000000..5f5a5a4
--- /dev/null
+++ b/src/common/spin_wait.h
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <chrono>
+
+#include "common/common_types.h"
+
+namespace Common {
+
+namespace SpinWait {
+
+/// Whether waits idle the core with UMONITOR/UMWAIT: the CPU has WAITPKG (Intel Tremont, Alder
+/// Lake and later), its TSC rate is known, and LICHII_WAITPKG_SPIN is not 0.
+bool UsesWaitpkg();
+
+/// TSC ticks a PAUSE instruction takes on this CPU (measured once).
+u64 PauseTicks();
+
+/// TSC ticks per microsecond.
+u64 TicksPerMicrosecond();
+
+u64 Now();
+void Pause();
+
+/// Arms the address monitor on `address`'s cache line (UMONITOR). Requires UsesWaitpkg().
+void Monitor(const void* address);
+
+/// Idles the core in C0.1 until `deadline` (TSC), a write to the monitored line or an
+/// interrupt (UMWAIT). Requires UsesWaitpkg().
+void WaitUntil(u64 deadline);
+
+template <typename Ready>
+bool IdleUntil(const void* address, u64 deadline, Ready& ready) {
+    // Conditions that are not on the monitored line are seen within a slice.
+    const u64 slice = 4 * TicksPerMicrosecond();
+    while (true) {
+        if (ready()) {
+            return true;
+        }
+        const u64 now = Now();
+        if (now >= deadline) {
+            return false;
+        }
+        Monitor(address);
+        if (ready()) {
+            return true;
+        }
+        WaitUntil(deadline - now > slice ? now + slice : deadline);
+    }
+}
+
+} // namespace SpinWait
+
+/// Waits until `ready()` holds, at most about as long as `pauses` PAUSE instructions take on
+/// this CPU. The first polls spin with PAUSE; after them, on CPUs with WAITPKG, the core idles
+/// in C0.1 until another core writes `address`'s cache line instead of executing PAUSE, which
+/// wakes as fast and leaves more of a power-limited CPU's budget to the busy cores. Returns
+/// whether `ready()` held.
+template <typename Ready>
+bool SpinUntil(const void* address, u32 pauses, Ready&& ready) {
+    constexpr u32 FastPolls = 64;
+    u32 spin = 0;
+    for (; spin < pauses && spin < FastPolls; ++spin) {
+        if (ready()) {
+            return true;
+        }
+        SpinWait::Pause();
+    }
+    if (spin < pauses && SpinWait::UsesWaitpkg()) {
+        const u64 deadline = SpinWait::Now() + u64{pauses - spin} * SpinWait::PauseTicks();
+        return SpinWait::IdleUntil(address, deadline, ready);
+    }
+    for (; spin < pauses; ++spin) {
+        if (ready()) {
+            return true;
+        }
+        SpinWait::Pause();
+    }
+    return ready();
+}
+
+/// Waits like SpinUntil for up to `duration`. Requires SpinWait::UsesWaitpkg().
+template <typename Ready>
+bool SpinUntilFor(const void* address, std::chrono::microseconds duration, Ready&& ready) {
+    const u64 deadline =
+        SpinWait::Now() + static_cast<u64>(duration.count()) * SpinWait::TicksPerMicrosecond();
+    return SpinWait::IdleUntil(address, deadline, ready);
+}
+
+} // namespace Common
