+TEST_CASE("Maxwell3D takes its macros back from the split's front once the split stops",
+          "[video_core][gpu_split_dependencies]") {
+    using Access = VideoCommon::GpuSplitTestAccess;
+    Fixture f;
+    VideoCommon::GpuSplit split;
+    Access::Initialize(split, f.system);
+    auto& engine = f.fast;
+    constexpr u32 StartAddressPointer = MAXWELL3D_REG_INDEX(load_mme.start_address_ptr);
+    constexpr u32 StartAddress = MAXWELL3D_REG_INDEX(load_mme.start_address);
+    const u32 state = f.state_methods.front();
+    // The front takes the macros over and tracks a state write in its shadow RAM copy.
+    engine.FrontCallMethod(f.system, split, state, 0x1234, true);
+    REQUIRE(engine.shadow_state.reg_array[state] != 0x1234);
+    // The split stopped: the next engine method runs on this thread, not the split's back.
+    engine.CallMethod(f.system, StartAddressPointer, 0, true);
+    engine.CallMethod(f.system, StartAddress, 0x40, true);
+    CHECK(engine.shadow_state.reg_array[state] == 0x1234);
+    CHECK(engine.GetNativeMacroPositions()[0] == 0x40);
+}
+
+TEST_CASE("Maxwell3D keeps state written after the split stops over the front's shadow RAM",
+          "[video_core][gpu_split_dependencies]") {
+    using Access = VideoCommon::GpuSplitTestAccess;
+    Fixture f;
+    VideoCommon::GpuSplit split;
+    Access::Initialize(split, f.system);
+    auto& engine = f.fast;
+    const u32 state = f.state_methods.front();
+    engine.FrontCallMethod(f.system, split, state, 0x1234, true);
+    // After the stop, DmaPusher sinks a state write and consumes the sink before the next
+    // executable method: the handback must come first so that write wins.
+    engine.method_sink.emplace_back(state, 0x5678);
+    engine.ConsumeSink(f.system);
+    engine.CallMethod(f.system, MAXWELL3D_REG_INDEX(load_mme.start_address_ptr), 0, true);
+    CHECK(engine.shadow_state.reg_array[state] == 0x5678);
+    CHECK(engine.regs.reg_array[state] == 0x5678);
+}
diff --git a/src/tests/video_core/memory_manager_runs.cpp b/src/tests/video_core/memory_manager_runs.cpp
index 3b2ecbf18..4f3460e41 100644
--- a/src/tests/video_core/memory_manager_runs.cpp
+++ b/src/tests/video_core/memory_manager_runs.cpp
@@ -61,6 +61,41 @@ public:
 
 } // namespace
 
+TEST_CASE("A 40-bit address space maps Switch 2 VA past 128 GiB", "[memory_manager]") {
+    ScopedSystemTestContext context;
+    Core::System system;
+    Core::DeviceMemory physical;
+    Tegra::MaxwellDeviceMemoryManager device_memory{physical};
+    NullRasterizer rasterizer;
+    // Nx2GpuVaEnd is 0xC000000000, so the GMMU is 40 bits. 0x2109ec0000 is the map that
+    // SIGSEGV'd PageTableOp when the tables only covered NvRm's 128 GiB range.
+    Tegra::MemoryManager memory{system, device_memory, 40, 1ULL << 34, 16};
+    memory.BindRasterizer(&rasterizer);
+
+    constexpr GPUVAddr gpu = 0x2109ec0000ULL;
+    constexpr DAddr dev = 0x1000;
+    constexpr u64 size = 0x20000;
+    memory.Map(gpu, dev, size, Tegra::PTEKind::PITCH, false);
+    REQUIRE(memory.GpuToCpuAddress(gpu) == dev);
+    REQUIRE(memory.GpuToCpuAddress(gpu + size - 1) == dev + size - 1);
+
+    constexpr GPUVAddr past_end = 1ULL << 40;
+    memory.Map(past_end, dev, size, Tegra::PTEKind::PITCH, false);
+    REQUIRE_FALSE(memory.GpuToCpuAddress(past_end).has_value());
+
+    // A map that starts on the last valid page and crosses the end must not replace that page.
+    constexpr GPUVAddr last_page = past_end - 0x1000;
+    constexpr DAddr last_dev = 0x3000;
+    memory.Map(last_page, last_dev, 0x1000, Tegra::PTEKind::PITCH, false);
+    REQUIRE(memory.GpuToCpuAddress(last_page) == last_dev);
+    memory.Map(last_page, last_dev + 0x1000, 0x2000, Tegra::PTEKind::PITCH, false);
+    REQUIRE(memory.GpuToCpuAddress(last_page) == last_dev);
+    // Unmap refuses the same crossing range, so the page stays mapped. A destroy that
+    // released backing after this would free memory the page table still points at.
+    memory.Unmap(last_page, 0x2000);
+    REQUIRE(memory.GpuToCpuAddress(last_page) == last_dev);
+}
