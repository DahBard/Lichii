+    def test_elf_path_symlink_and_precedence(self):
+        (self.root / "nx2_switches.txt").write_text("EDEN_NX2_PRELOAD_ALL_PIPELINES=99\n")
+        self.assertEqual(self.run_probe(self.bin / "lichii"), "unset")
