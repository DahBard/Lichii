+} // Anonymous namespace
+
+std::vector<CodeMatch> FindGameCode(std::span<const u8> recipe, const X::Result& programs,
+                                    unsigned threads) {
+    return FindCodeInBody(Decompress(recipe), programs, threads);
+}
