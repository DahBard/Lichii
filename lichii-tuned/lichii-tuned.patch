--- /dev/null
+++ b/dist/lichii-tuned/ab-1-stock-threading.bat
@@ -0,0 +1,4 @@
+@echo off
+rem Compiler changes only: Windows places threads, PAUSE spinning.
+set LICHII_CPU_POLICY=off&& set LICHII_WAITPKG_SPIN=0
+start "" "%~dp0lichii.exe" %*
diff --git a/dist/lichii-tuned/ab-10-run-ahead.bat b/dist/lichii-tuned/ab-10-run-ahead.bat
new file mode 100644
index 000000000..66de3f875
--- /dev/null
+++ b/dist/lichii-tuned/ab-10-run-ahead.bat
@@ -0,0 +1,6 @@
+@echo off
+rem The game prepares the next frame while the GPU still renders this one, also when the GPU
+rem is behind (EDEN_NX2_FRAMES_AHEAD=2), so a slow GPU never idles between frames. Also logs
+rem GPU timing like perf-trace.bat, for comparison.
+set EDEN_NX2_FRAMES_AHEAD=2&& set EDEN_NX2_GPU_PROFILE=1&& set EDEN_DKB_FRAME_TRACE=1
+start "" "%~dp0lichii.exe" %*
diff --git a/dist/lichii-tuned/ab-11-official-shader-cache.bat b/dist/lichii-tuned/ab-11-official-shader-cache.bat
