+            return;
+        }
+        auto& ids = it->second;
+        ids.erase(std::remove(ids.begin(), ids.end(), framebuffer_id), ids.end());
+        if (ids.empty()) {
+            framebuffers_by_view.erase(it);
+        }
+    };
