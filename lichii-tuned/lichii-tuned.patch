+#include "video_core/macro_turing.h"
+
+// GPU-written command lists whose words the host GPU takes over (EDEN_NX2_LIST_INDIRECT, on
+// unless =0). Ocarina of Time's compute culling writes the group counts of a later dispatch as
+// the parameters of a macro call (compute method 0xe74): the split GPU thread's front had to
+// wait for that work to run on the host GPU and its copy to come back before it could parse
+// them (~145 ms of every second). The macros only move those words: 0xe74 stores them in the
+// data RAM, 0xe7a uploads them with the dispatch's constant buffer (an inline upload), 0xe76
+// writes them into the inline QMD as its grid. So the front need not know them:
+// - At the list's place, the back copies the words on the host GPU into a slot of its own (the
+//   snapshot: the list may be written again before the QMD launches).
+// - The front parses placeholders for them, values that name the slot and the word, and runs the
+//   macros that see them in a tagged dry run (RunTagged): a tagged value may be moved, stored in
+//   the data RAM or emitted as an inline upload's data or as an inline QMD's grid, nothing else
+//   (no branch, computation or address depends on it). Any other use, and any 3D macro that
+//   may read a tagged data RAM word, concretizes the words first: the front reads the slot back
+//   and goes on with the real words, as before.
+// - The back dispatches a QMD whose grid words are one slot's placeholders indirectly from the
+//   slot, and patches the uploaded words into the constant buffers compute dispatches bind
+//   (the "owed" words), from the slot.
+namespace Tegra::Nx2ListIndirect {
+
+[[nodiscard]] inline bool SwitchSet() {
+    const char* value = std::getenv("EDEN_NX2_LIST_INDIRECT");
+    return value == nullptr || value[0] != '0';
+}
+
+// A plain flag: checked at every GPU-written list.
+inline bool g_enabled = SwitchSet();
+
+/// Called by VideoCore::CreateGPU: static initialization runs before the frontend loads
+/// nx2_switches.txt, so a switch set only there takes effect from that point on.
+inline void ReadSwitch() {
+    g_enabled = SwitchSet();
+}
+
+/// Slots the back keeps snapshots of list words in, and the words a slot holds.
+inline constexpr u32 SlotCount = 4096;
+inline constexpr u32 SlotWords = 3;
+
+/// The value the front carries for word `word` of the list in `slot`. A real grid never has a
+/// width this large (it is over 4 billion groups). Word 0 is never 0 and the low 16 bits of words
+/// 1 and 2 never are, so the QMD scheduler's empty grid check never drops a dispatch whose grid
+/// is placeholders (the host GPU dispatches no groups for an empty one).
+inline constexpr u32 PlaceholderMagic = 0xF1A90000U;
+static_assert((SlotCount << 2) <= 0x10000);
+
+[[nodiscard]] constexpr u32 Placeholder(u32 slot, u32 word) {
+    return PlaceholderMagic | (slot << 2) | word;
+}
+[[nodiscard]] constexpr bool IsPlaceholder(u32 value) {
+    return (value & 0xFFFF0000U) == PlaceholderMagic && (value & 3) < SlotWords;
+}
+[[nodiscard]] constexpr u32 PlaceholderSlot(u32 value) {
+    return (value & 0xFFFFU) >> 2;
+}
+[[nodiscard]] constexpr u32 PlaceholderWord(u32 value) {
+    return value & 3;
+}
+static_assert(Placeholder(0, 0) != 0 && (Placeholder(0, 1) & 0xFFFF) != 0 &&
+              (Placeholder(0, 2) & 0xFFFF) != 0);
+
+/// The slot whose three words a QMD's grid (words 12-14) is, if it is one.
+[[nodiscard]] constexpr std::optional<u32> GridSlot(u32 x, u32 y, u32 z) {
+    if (!IsPlaceholder(x) || x != Placeholder(PlaceholderSlot(x), 0)) {
+        return std::nullopt;
+    }
+    const u32 slot = PlaceholderSlot(x);
+    if (y != Placeholder(slot, 1) || z != Placeholder(slot, 2)) {
+        return std::nullopt;
+    }
+    return slot;
+}
+
+/// What a tagged dry run wrote, in order: emits (method, value) and data RAM stores (word,
+/// value), `tagged` where the value is a list word moved there unchanged.
+struct TaggedWrite {
+    u32 address;
+    u32 value;
+    bool tagged;
+};
+
+struct TaggedRun {
+    enum class Outcome {
+        Done,    ///< Ran to its end: emits and data_ram are what Execute does
+        Escaped, ///< A tagged value reached something other than a move, a store or an emit
+        Failed,  ///< The call fails (as Execute fails it): run it the old way
+    };
+    Outcome status{};
+    std::string_view why;
+    std::vector<TaggedWrite> emits;
+    std::vector<TaggedWrite> data_ram;
+    size_t consumed{};
+};
+
+/// A dry run of a macro call, as TuringMacroInterpreter::Execute runs it, that follows the list
+/// words through it: `params` (the load FIFO) with `params_tagged`, the data RAM words as
+/// `read_data_ram(word)` returns them (value, tagged; word < 0xc00), the registers as
+/// `read_register(address)` (value, tagged; as the engine's read callback). The call's own
+/// stores and emits are kept in `run` and read back from there, as Execute's go to the data RAM
+/// and, through the engine, to its registers. Nothing outside `run` changes.
+///
+/// A tagged value stays tagged through a move: an ALU operation whose other operand is the
+/// identity of the operation and not tagged itself (x + 0, x - 0, x | 0, x ^ 0, x & ~0,
+/// x << 0 and the shifts by 0, a merge of no bits), a register, the data RAM, an emit. Any other
+/// use (a branch, a predicate, a loop count, an address, a method, any other computation) ends
+/// the run as Escaped. Every tagged value is then a list word unchanged: the call takes the same
+/// path whatever the words are, and writes them, and only them, where it wrote the tagged values.
+template <typename ReadDataRam, typename ReadRegister>
+void RunTagged(std::span<const u32> code, u32 start, std::span<const u32> params,
+               std::span<const u8> params_tagged, ReadDataRam&& read_data_ram,
+               ReadRegister&& read_register, std::vector<TuringMacroInterpreter::Decoded>& decoded,
+               TaggedRun& run) {
+    using Word = u32;
+    using Decoded = TuringMacroInterpreter::Decoded;
+    run = {};
+    std::array<Word, 24> regs{};
+    std::array<bool, 24> regs_tagged{};
+    Word initialized{}, carry{}, method{}, increment{};
+    Word pc = start, loop_count{}, loop_start{}, loop_end{};
+    size_t consumed{};
+    bool end_next{}, stopped{};
+    std::string_view error;
+    const auto fail = [&](std::string_view message) {
+        if (error.empty())
+            error = message;
+    };
+    bool escaped{};
+    const auto escape = [&](std::string_view why) {
+        if (!escaped) {
+            escaped = true;
+            run.why = why;
+        }
+    };
+    const auto data_ram = [&](Word address) -> std::pair<Word, bool> {
+        for (auto it = run.data_ram.rbegin(); it != run.data_ram.rend(); ++it) {
+            if (it->address == address) {
+                return {it->value, it->tagged};
+            }
+        }
+        return read_data_ram(address);
+    };
+    const auto register_value = [&](Word address) -> std::pair<Word, bool> {
+        // The engine's registers hold what the call emitted to them (FrontApply).
+        for (auto it = run.emits.rbegin(); it != run.emits.rend(); ++it) {
+            if (it->address == address) {
+                return {it->value, it->tagged};
+            }
+        }
+        return read_register(address);
+    };
+    if (decoded.size() < code.size() / 3)
+        decoded.resize(code.size() / 3);
+    constexpr size_t data_ram_size = std::tuple_size_v<TuringMacroInterpreter::DataRam>;
+    for (Word steps = 0; steps < 1000000 && !escaped; ++steps) {
+        if (static_cast<size_t>(pc) * 3 + 2 >= code.size()) {
+            fail("instruction outside uploaded RAM");
+            break;
+        }
+        const std::array<Word, 3> bits{code[pc * 3 + 2], code[pc * 3 + 1], code[pc * 3]};
+        Decoded& d = decoded[pc];
+        if (d.raw != bits)
+            d = TuringMacroInterpreter::Decode(bits);
+        std::array<Word, 2> load{}, alu{};
+        std::array<bool, 2> load_tagged{}, alu_tagged{};
+        for (Word i = 0; i < 2; ++i) {
+            if (d.load[i]) {
+                if (consumed >= params.size()) {
+                    fail("parameter FIFO underflow");
+                    break;
+                }
+                load_tagged[i] = consumed < params_tagged.size() && params_tagged[consumed] != 0;
+                load[i] = params[consumed++];
+            }
+        }
+        bool operand_tagged{};
+        const auto get = [&](Word reg, Word lane) -> Word {
+            operand_tagged = false;
+            if (reg < 24) {
+                if (!(initialized & (1U << reg)))
+                    fail("uninitialized register read");
+                operand_tagged = regs_tagged[reg];
+                return regs[reg];
+            }
+            switch (reg) {
+            case 24:
+                return 0;
+            case 25:
+                return Word(std::int32_t(std::int16_t(d.imm[lane])));
+            case 26:
+                return Word(std::int32_t(std::int16_t(d.imm[1 - lane])));
+            case 27:
+                return (d.imm[0] << 16) | d.imm[1];
+            case 28:
+                operand_tagged = load_tagged[0];
+                return load[0];
+            case 29:
+                operand_tagged = load_tagged[1];
+                return load[1];
+            default:
+                fail("invalid source register");
+                return 0;
+            }
+        };
+        Word mask = 15;
+        if (d.pred_mode) {
+            const Word predicate = get(d.pred_reg, 0);
+            if (operand_tagged) {
+                escape("a predicate");
+                break;
+            }
+            mask = predicate ? d.mask_true : d.mask_false;
+        }
+        std::array<Word, 2> xs{}, ys{};
+        std::array<bool, 2> xs_tagged{}, ys_tagged{};
+        for (Word lane = 0; lane < 2; ++lane) {
+            if (mask & (1U << lane)) {
+                xs[lane] = get(d.src_a[lane], lane);
+                xs_tagged[lane] = operand_tagged;
+                ys[lane] = get(d.src_b[lane], lane);
+                ys_tagged[lane] = operand_tagged;
+            }
+        }
+        Word next_pc = pc + 1;
+        bool branch_cancels_end{};
+        for (Word lane = 0; lane < 2 && error.empty() && !escaped; ++lane) {
+            if (!(mask & (1U << lane)))
+                continue;
+            const Word x = xs[lane], y = ys[lane];
+            const bool tx = xs_tagged[lane], ty = ys_tagged[lane];
+            const Word imm = d.imm[lane];
+            Word value{};
+            bool tagged{};
+            // A tagged operand moved unchanged through the operation: x with y its identity, or
+            // y with x its identity (`commutes`).
+            const auto move = [&](Word identity, bool commutes, std::string_view what) {
+                if (tx && !ty && y == identity) {
+                    tagged = true;
+                    return x;
+                }
+                if (commutes && ty && !tx && x == identity) {
+                    tagged = true;
+                    return y;
+                }
+                escape(what);
+                return Word{};
+            };
+            const auto condition = [&](Word comparison) {
+                switch (comparison) {
+                case 17:
+                case 25:
+                    return std::int32_t(x) < std::int32_t(y);
+                case 18:
+                case 26:
+                    return x < y;
+                case 19:
+                case 27:
+                    return std::int32_t(x) <= std::int32_t(y);
+                case 20:
+                case 28:
+                    return x <= y;
+                default:
+                    return x == y;
+                }
+            };
+            const bool any_tagged = tx || ty;
+            switch (d.op[lane]) {
+            case 0:
+                if (any_tagged) {
+                    value = move(0, true, "an addition");
+                    carry = 0; // x + 0 never carries
+                } else {
+                    value = x + y;
+                    carry = value < x;
+                }
+                break;
+            case 1:
+                if (!any_tagged) {
+                    value = x + y + carry;
+                } else if (carry == 0) {
+                    value = move(0, true, "an addition");
+                } else {
+                    escape("an addition");
+                }
+                break;
+            case 2:
+                if (any_tagged) {
+                    value = move(0, false, "a subtraction");
+                    carry = 0; // x - 0 never borrows
+                } else {
+                    value = x - y;
+                    carry = value > x;
+                }
+                break;
+            case 3:
+                if (!any_tagged) {
+                    value = x - y - carry;
+                } else if (carry == 0) {
+                    value = move(0, false, "a subtraction");
+                } else {
+                    escape("a subtraction");
+                }
+                break;
+            case 4:
+            case 6: {
+                if (any_tagged) {
+                    escape("a multiplication");
+                    break;
+                }
+                const std::uint64_t a =
+                    d.op[lane] == 4 ? std::uint64_t(std::int64_t(std::int32_t(x))) : x;
+                const std::uint64_t b =
+                    d.op[lane] == 4 ? std::uint64_t(std::int64_t(std::int32_t(y))) : y;
+                const auto product = a * b;
+                value = Word(product);
+                carry = Word(product >> 32);
+                break;
+            }
+            case 5:
+                value = carry;
+                break;
+            case 7:
+                if (tx) {
+                    escape("an extended operation");
+                    break;
+                }
+                if (x != 0x1000)
+                    fail("unsupported extended operation");
+                break;
+            case 8:
+                if (tx) {
+                    escape("a leading zero count");
+                    break;
+                }
+                value = Word(std::countl_zero(x));
+                break;
+            case 9:
+            case 10:
+            case 11:
+                if (any_tagged) {
+                    // Shifts take y's low 5 bits: a tagged x moves by a shift of 0.
+                    if (!ty && (y & 31) == 0) {
+                        value = x;
+                        tagged = true;
+                    } else {
+                        escape("a shift");
+                    }
+                } else {
+                    value = d.op[lane] == 9    ? x << (y & 31)
+                            : d.op[lane] == 10 ? x >> (y & 31)
+                                               : Word(std::int32_t(x) >> (y & 31));
+                }
+                break;
+            case 12:
+                value = any_tagged ? move(~0U, true, "an and") : x & y;
+                break;
+            case 13:
+                if (any_tagged) {
+                    escape("a nand");
+                    break;
+                }
+                value = ~(x & y);
+                break;
+            case 14:
+                value = any_tagged ? move(0, true, "an or") : x | y;
+                break;
+            case 15:
+                value = any_tagged ? move(0, true, "an exclusive or") : x ^ y;
+                break;
+            case 16: {
+                const Word dest = (imm >> 10) & 63, count = (imm >> 5) & 31;
+                const Word source = imm & 31;
+                if (dest >= 32) {
+                    fail("invalid merge destination");
+                    break;
+                }
+                const Word bits_mask = (1U << count) - 1;
+                if (any_tagged) {
+                    // Merging no bits leaves x unchanged; a tagged y never moves whole.
+                    if (tx && !ty && count == 0) {
+                        value = x;
+                        tagged = true;
+                    } else {
+                        escape("a merge");
+                    }
+                    break;
+                }
+                value = (x & ~(bits_mask << dest)) | (((y >> source) & bits_mask) << dest);
+                break;
+            }
+            case 17:
+            case 18:
+            case 19:
+            case 20:
+            case 21:
+                if (any_tagged) {
+                    escape("a comparison");
+                    break;
+                }
+                value = condition(d.op[lane]) ? ~0U : 0;
+                break;
+            case 22: {
+                if (any_tagged) {
+                    escape("a register address");
+                    break;
+                }
+                const auto [read, read_tagged] = register_value((x + y) & 0xffff);
+                value = read;
+                tagged = read_tagged;
+                break;
+            }
+            case 23:
+                if (tx) {
+                    escape("a loop count");
+                    break;
+                }
+                if (loop_count || imm < 2) {
+                    fail("invalid loop");
+                    break;
+                }
+                if (x == 0) {
+                    next_pc = pc + imm;
+                    break;
+                }
+                loop_count = x - 1;
+                loop_start = pc;
+                loop_end = pc + imm - 1;
+                break;
+            case 24:
+                next_pc = pc + (imm & 0x7fff);
+                break;
+            case 25:
+            case 26:
+            case 27:
+            case 28:
+            case 29:
+                if (any_tagged) {
+                    escape("a branch");
+                    break;
+                }
+                if (condition(d.op[lane]) == bool(imm & 0x8000)) {
+                    const auto offset = std::int32_t(imm << 19) >> 19;
+                    if (offset == -4096)
+                        stopped = true;
+                    else {
+                        next_pc = Word(std::int32_t(pc) + offset);
+                        branch_cancels_end = (imm & 0x4000) != 0;
+                    }
+                }
+                break;
+            case 30: {
+                if (tx) {
+                    escape("a data RAM address");
+                    break;
+                }
+                if (x >= data_ram_size) {
+                    fail("data RAM read out of bounds");
+                    break;
+                }
+                const auto [read, read_tagged] = data_ram(x);
+                value = read;
+                tagged = read_tagged;
+                break;
+            }
+            case 31:
+                if (tx) {
+                    escape("a data RAM address");
+                    break;
+                }
+                if (x >= data_ram_size) {
+                    fail("data RAM write out of bounds");
+                    break;
+                }
+                run.data_ram.push_back({x, y, ty});
+                break;
+            }
+            if (escaped)
+                break;
+            alu[lane] = value;
+            alu_tagged[lane] = tagged;
+            if (d.dst[lane] < 24) {
+                regs[d.dst[lane]] = value;
+                regs_tagged[d.dst[lane]] = tagged;
+                initialized |= 1U << d.dst[lane];
+            } else if (d.dst[lane] != 24)
+                fail("invalid destination register");
+        }
+        if (escaped)
+            break;
+        bool output_tagged{};
+        const auto output = [&](Word selector) -> Word {
+            output_tagged = false;
+            switch (selector) {
+            case 1:
+                output_tagged = alu_tagged[0];
+                return alu[0];
+            case 2:
+                output_tagged = alu_tagged[1];
+                return alu[1];
+            case 3:
+                output_tagged = load_tagged[0];
+                return load[0];
+            case 4:
+                output_tagged = load_tagged[1];
+                return load[1];
+            case 5:
+                return d.imm[0];
+            case 6:
+                return d.imm[1];
+            case 8:
+                return d.imm[0] >> 12;
+            case 9:
+                return d.imm[1] >> 12;
+            case 10:
+                return (d.imm[0] << 16) | d.imm[1];
+            default:
+                fail("invalid output selector");
+                return 0;
+            }
+        };
+        for (Word lane = 0; lane < 2 && error.empty() && !escaped; ++lane) {
+            if (!(mask & (4U << lane)))
+                continue;
+            if (d.out_method[lane]) {
+                const Word address = output(d.out_method[lane]);
+                if (output_tagged) {
+                    escape("a method");
+                    break;
+                }
+                method = address & 0xfff;
+                increment = (address >> 12) & 15;
+            }
+            if (d.out_emit[lane]) {
+                const Word value = output(d.out_emit[lane]);
+                if (error.empty()) {
+                    // The engines' emit refuses macro methods.
+                    if (method >= 0xe00)
+                        fail("unsupported emitted method");
+                    else
+                        run.emits.push_back({method, value, output_tagged});
+                }
+                method += increment;
+            }
+        }
+        if (escaped || !error.empty())
+            break;
+        if (end_next || stopped) {
+            run.status = TaggedRun::Outcome::Done;
+            run.consumed = consumed;
+            return;
+        }
+        end_next = d.end && !branch_cancels_end;
+        if (loop_count && pc == loop_end) {
+            --loop_count;
+            next_pc = loop_start + 1;
+        }
+        pc = next_pc;
+    }
+    run.consumed = consumed;
+    if (escaped) {
+        run.status = TaggedRun::Outcome::Escaped;
+        return;
+    }
+    run.status = TaggedRun::Outcome::Failed;
+    run.why = error.empty() ? std::string_view{"instruction limit exceeded"} : error;
+}
+
+/// A data RAM word or a register that holds a list word: as long as it holds `value`, the
+/// placeholder of word PlaceholderWord(value) of slot PlaceholderSlot(value). Anything that
+/// writes it another value ends that (checked where it is used).
+struct Holder {
+    u32 address;
+    u32 value;
+};
+
+/// What the macros of one engine's code can read (TuringMacroInterpreter::AnalyzeEffects), by
+/// start, for the code generation it was asked for last.
+class ReadsCache {
+public:
+    struct Reads {
+        bool data_ram_known{};
+        bool registers_known{};
+        std::vector<u32> data_ram;
+        std::vector<u32> registers;
+    };
+
+    [[nodiscard]] const Reads& Get(std::span<const u32> code, u64 generation, u32 start) {
+        if (generation != code_generation || code.data() != code_data) {
+            index.clear();
+            reads.clear();
+            code_generation = generation;
+            code_data = code.data();
+        }
+        if (start >= index.size()) {
+            index.resize(static_cast<size_t>(start) + 1, NoEntry);
+        }
+        if (index[start] == NoEntry) {
+            auto effects = TuringMacroInterpreter::AnalyzeEffects(code, start);
+            reads.push_back({effects.data_ram_reads_known, effects.register_reads_known,
+                             std::move(effects.data_ram_reads), std::move(effects.register_reads)});
+            index[start] = static_cast<u32>(reads.size() - 1);
+        }
+        return reads[index[start]];
+    }
+
+private:
+    static constexpr u32 NoEntry = ~0U;
+    std::vector<u32> index;
+    std::vector<Reads> reads;
+    u64 code_generation{~u64{0}};
+    const u32* code_data{};
+};
+
+/// Whether a macro that reads `reads` (any word unless `known`) may read one of `holders`.
+[[nodiscard]] inline bool MayRead(bool known, std::span<const u32> reads,
+                                  std::span<const Holder> holders) {
+    if (holders.empty()) {
+        return false;
+    }
+    if (!known) {
+        return true;
+    }
+    return std::ranges::any_of(holders, [reads](const Holder& holder) {
+        return std::ranges::binary_search(reads, holder.address);
+    });
+}
+
+/// The back drops a hold of `slot` (the rasterizer's Nx2ReleaseListSlot), after what the front
+/// sent before; at once while the split is off.
+template <typename Rasterizer>
+void ReleaseSlot(VideoCommon::GpuSplit& split, Rasterizer* rasterizer, u32 slot) {
+    if (!split.Active()) {
+        rasterizer->Nx2ReleaseListSlot(slot);
+        return;
+    }
+    split.Defer([rasterizer, slot] { rasterizer->Nx2ReleaseListSlot(slot); },
+                VideoCommon::GpuSplit::Writes::Noted);
+}
+
+/// The words of `slots` (three a slot), once the back ran what the front sent before and the
+/// host GPU copied them (the rasterizer's Nx2ReadListSlots): the front waits for both.
+template <typename Rasterizer>
+void ReadSlots(VideoCommon::GpuSplit& split, Rasterizer* rasterizer, std::span<const u32> slots,
+               std::span<u32> words) {
+    split.Run(
+        [rasterizer, slot_data = slots.data(), count = slots.size(), out = words.data()] {
+            rasterizer->Nx2ReadListSlots(std::span<const u32>{slot_data, count},
+                                         std::span<u32>{out, count * SlotWords});
+        },
+        VideoCommon::DrainSite::ListCopies);
+}
+
+/// The front's holds of the back's slots: one per holder and per call that takes list words.
+/// Once the front holds a slot no more, it drops the hold the back gave it the slot with, after
+/// everything it sent with the slot's placeholders (in order on the split's ring).
+inline std::array<u16, SlotCount>& FrontHolds() {
+    static std::array<u16, SlotCount> holds{};
+    return holds;
+}
+
+/// A channel's data RAM words that hold list words, and what its 3D macros can read. Its compute
+/// engine's front puts list words there; its 3D engine's front checks its macros against them.
+struct DataRamWords {
+    const void* data_ram{};
+    std::vector<Holder> words;
+    ReadsCache reads_3d;
+};
+
+/// Every channel's, by data RAM (front thread only; a channel's goes with its compute engine).
+inline std::vector<DataRamWords>& Channels() {
+    static std::vector<DataRamWords> channels;
+    return channels;
+}
+
+[[nodiscard]] inline DataRamWords* FindChannel(const void* data_ram) {
+    for (DataRamWords& channel : Channels()) {
+        if (channel.data_ram == data_ram) {
+            return &channel;
+        }
+    }
+    return nullptr;
+}
+
+[[nodiscard]] inline DataRamWords& GetChannel(const void* data_ram) {
+    if (DataRamWords* channel = FindChannel(data_ram)) {
+        return *channel;
+    }
+    return Channels().emplace_back(DataRamWords{data_ram, {}, {}});
+}
+
+/// The channel's compute engine is destroyed. With no channel left (the session ended, and the
+/// back's slots went with its rasterizer) the front holds none either.
+inline void ForgetChannel(const void* data_ram) {
+    std::erase_if(Channels(),
+                  [data_ram](const DataRamWords& channel) { return channel.data_ram == data_ram; });
+    if (Channels().empty()) {
+        FrontHolds().fill(0);
+    }
+}
+
+/// Drops a front hold of `slot`; `release(slot)` once the front holds it no more.
+template <typename Release>
+void DropHold(u32 slot, Release&& release) {
+    if (--FrontHolds()[slot] == 0) {
+        release(slot);
+    }
+}
+
+/// Drops the holders that no longer hold their placeholder (`value(address)` differs).
+template <typename Value, typename Release>
+void Prune(std::vector<Holder>& holders, Value&& value, Release&& release) {
+    std::erase_if(holders, [&](const Holder& holder) {
+        if (value(holder.address) == holder.value) {
+            return false;
+        }
+        DropHold(PlaceholderSlot(holder.value), release);
+        return true;
+    });
+}
+
+/// From now on `address` holds `value`: a list word if `tagged`, else nothing of the front's.
+template <typename Release>
+void Hold(std::vector<Holder>& holders, u32 address, u32 value, bool tagged, Release&& release) {
+    if (tagged) {
+        ++FrontHolds()[PlaceholderSlot(value)]; // First: an old hold of the slot stays above 0
+    }
+    const auto it = std::ranges::find(holders, address, &Holder::address);
+    if (it != holders.end()) {
+        const u32 slot = PlaceholderSlot(it->value);
+        holders.erase(it);
+        DropHold(slot, release);
+    }
+    if (tagged) {
+        holders.push_back({address, value});
+    }
+}
+
+/// The words of `slots` as `read_slots(slots, words)` returns them (three a slot), by
+/// placeholder.
+struct SlotWordsRead {
+    std::vector<u32> slots;
+    std::vector<u32> words;
+
+    void Add(u32 placeholder) {
+        const u32 slot = PlaceholderSlot(placeholder);
+        if (std::ranges::find(slots, slot) == slots.end()) {
+            slots.push_back(slot);
+        }
+    }
+    template <typename ReadSlots>
+    void Read(ReadSlots&& read_slots) {
+        words.assign(slots.size() * SlotWords, 0);
+        if (!slots.empty()) {
+            read_slots(std::span<const u32>{slots}, std::span<u32>{words});
+        }
+    }
+    [[nodiscard]] u32 Word(u32 placeholder) const {
+        const size_t index = static_cast<size_t>(
+            std::ranges::find(slots, PlaceholderSlot(placeholder)) - slots.begin());
+        return words[index * SlotWords + PlaceholderWord(placeholder)];
+    }
+};
+
+/// Replaces the placeholders the data RAM words `holders` still hold by their words, read back
+/// from the slots (`read_slots` waits for the back and the host GPU), and drops the holders.
+/// Returns how many slots it read.
+template <typename ReadSlots, typename Release>
+u32 ConcretizeDataRam(std::vector<Holder>& holders, std::span<u32> data_ram, ReadSlots&& read_slots,
+                      Release&& release) {
+    SlotWordsRead read;
+    for (const Holder& holder : holders) {
+        read.Add(holder.value);
+    }
+    read.Read(read_slots);
+    for (const Holder& holder : holders) {
+        if (data_ram[holder.address] == holder.value) {
+            data_ram[holder.address] = read.Word(holder.value);
+        }
+        DropHold(PlaceholderSlot(holder.value), release);
+    }
+    holders.clear();
+    return static_cast<u32>(read.slots.size());
+}
+
+/// What the front knows of a compute engine's inline upload as the back runs it
+/// (Upload::State): the words the data methods sent since the last exec, and the size and layout
+/// the exec started it with.
+struct UploadState {
+    u32 words{};
+    u32 size{};
+    bool linear{};
+};
+
+/// The compute class's inline upload methods (KeplerCompute::Regs::upload and the two after).
+inline constexpr u32 UploadLineLength = 0x60;
+inline constexpr u32 UploadLineCount = 0x61;
+inline constexpr u32 UploadAddressHigh = 0x62;
+inline constexpr u32 UploadAddressLow = 0x63;
+inline constexpr u32 UploadExec = 0x6c;
+inline constexpr u32 UploadData = 0x6d;
+/// The inline QMD's grid words (LOAD_INLINE_QMD_DATA, QMD words 12-14).
+inline constexpr u32 InlineQmdGridFirst = 0xc8 + 12;
+inline constexpr u32 InlineQmdGridLast = 0xc8 + 14;
+
+/// As Upload::State::ProcessExec and ProcessData count an inline upload: `method` with
+/// `argument` sent to the engine, `reg(method)` the registers as they were before it.
+template <typename Register>
+void NoteUploadMethod(UploadState& upload, u32 method, u32 argument, Register&& reg) {
+    if (method == UploadExec) {
+        upload.words = 0;
+        upload.size = reg(UploadLineLength) * reg(UploadLineCount);
+        upload.linear = (argument & 1) != 0;
+    } else if (method == UploadData) {
+        ++upload.words;
+    }
+}
+
+/// Why the front read list words after all (the counters).
+enum class Reason : u32 {
+    Escaped, ///< A macro used a tagged value otherwise than moving it (RunTagged)
+    Failed,  ///< The dry run failed: the call runs the old way, as it fails there
+    Sink,    ///< A tagged value reached another register, or an upload the back can't place
+    Upload,  ///< A macro that takes list words loads macro code or binds macros
+    Macro3d, ///< A 3D macro may read a data RAM word that holds one
+    Stop,    ///< The split stopped
+    Count,
+};
+
+/// One compute engine's front while list words are about (KeplerCompute::FrontRunMacro): the
+/// registers that hold list words, the call whose parameters are list words, and the caches of
+/// the dry runs. `Context` is the engine's, for one call:
+/// - std::span<const u32> code; u64 generation; u32 start: the call's macro;
+/// - std::vector<u32>& params; std::span<u32> data_ram; std::span<const u32> registers;
+/// - UploadState upload: before the call;
+/// - std::optional<u64> DeviceWord(u64 gpu_address): the device address of the 4 bytes there,
+///   if they are mapped, on one page, as the back will find them;
+/// - void Emit(u32 method, u32 value): the engine's emit (FrontApply and the split);
+/// - void SendOwed(u64 device, u32 value): the back patches the slot word that `value` is the
+///   placeholder of into the constant buffers compute dispatches bind there;
+/// - void Release(u32 slot): the back drops the front's hold of the slot;
+/// - void ReadSlots(std::span<const u32> slots, std::span<u32> words): the words (waits);
+/// - void SetRegister(u32 method, u32 value): a concretized register, on the front and the back.
+class ComputeFront {
+public:
+    /// DmaPusher, at a list of `count` words on GPU-written pages that are all the parameters of
+    /// the call about to run: whether a dry run of the call with them as tagged parameters leaves
+    /// them only where the back takes them over. If so the call takes `slot`'s placeholders as
+    /// its parameters (the front holds the slot for it) and runs tagged (Run).
+    template <typename Context>
+    [[nodiscard]] bool PrepareCall(Context& ctx, DataRamWords& channel, u32 slot, u32 count) {
+        // Holders the macros the front ran untagged wrote over give their slots back.
+        const auto release = [&ctx](u32 held) { ctx.Release(held); };
+        Prune(channel.words, [&ctx](u32 address) { return ctx.data_ram[address]; }, release);
+        Prune(registers, [&ctx](u32 address) { return ctx.registers[address]; }, release);
+        std::vector<u32> params(count);
+        for (u32 k = 0; k < count; ++k) {
+            params[k] = Placeholder(slot, k);
+        }
+        TaggedRun run;
+        DryRun(ctx, channel, params, true, run);
+        if (run.status != TaggedRun::Outcome::Done || !Places(ctx, run)) {
+            return false;
+        }
+        if (pending.active) [[unlikely]] {
+            DropPending(ctx);
+        }
+        pending = Pending{slot, count, true};
+        ++FrontHolds()[slot];
+        return true;
+    }
+
+    /// The call `ctx` describes, at its last parameter. If it takes list words, or may read a
+    /// data RAM word or register that holds one, runs it tagged and returns true. Otherwise, and
+    /// where its list words go elsewhere than the back follows them (it concretizes every list
+    /// word about first: `concretized`, `reason`), the caller runs it as before (false).
+    template <typename Context>
+    [[nodiscard]] bool Run(Context& ctx, DataRamWords& channel, bool& concretized, Reason& reason) {
+        concretized = false;
+        const bool takes =
+            pending.active && pending.count == ctx.params.size() && TakesPlaceholders(ctx.params);
+        if (pending.active && !takes) [[unlikely]] {
+            DropPending(ctx); // Not the call it was prepared for
+        }
+        if (!takes) {
+            if (channel.words.empty() && registers.empty()) {
+                return false;
+            }
+            if (!MayReadHeld(ctx, channel)) {
+                return false;
+            }
+            const auto release = [&ctx](u32 slot) { ctx.Release(slot); };
+            Prune(channel.words, [&ctx](u32 address) { return ctx.data_ram[address]; }, release);
+            Prune(registers, [&ctx](u32 address) { return ctx.registers[address]; }, release);
+            if (!MayReadHeld(ctx, channel)) {
+                return false;
+            }
+        }
+        TaggedRun run;
+        DryRun(ctx, channel, ctx.params, takes, run);
+        if (run.status == TaggedRun::Outcome::Done && Places(ctx, run)) {
+            Commit(ctx, channel, run);
+            if (takes) {
+                DropPending(ctx);
+            }
+            return true;
+        }
+        reason = run.status == TaggedRun::Outcome::Escaped  ? Reason::Escaped
+                 : run.status == TaggedRun::Outcome::Failed ? Reason::Failed
+                                                            : place_reason;
+        ConcretizeAll(ctx, channel);
+        concretized = true;
+        return false;
+    }
+
+    /// Replaces every list word the channel's data RAM, this engine's registers and the pending
+    /// call's parameters hold by the word itself, read back from its slot.
+    template <typename Context>
+    void ConcretizeAll(Context& ctx, DataRamWords& channel) {
+        const auto release = [&ctx](u32 slot) { ctx.Release(slot); };
+        const bool params =
+            pending.active && pending.count == ctx.params.size() && TakesPlaceholders(ctx.params);
+        SlotWordsRead read;
+        for (const Holder& holder : channel.words) {
+            read.Add(holder.value);
+        }
+        for (const Holder& holder : registers) {
+            read.Add(holder.value);
+        }
+        if (params) {
+            read.Add(Placeholder(pending.slot, 0));
+        }
+        read.Read([&ctx](std::span<const u32> slots, std::span<u32> words) {
+            ctx.ReadSlots(slots, words);
+        });
+        for (const Holder& holder : channel.words) {
+            if (ctx.data_ram[holder.address] == holder.value) {
+                ctx.data_ram[holder.address] = read.Word(holder.value);
+            }
+            DropHold(PlaceholderSlot(holder.value), release);
+        }
+        channel.words.clear();
+        for (const Holder& holder : registers) {
+            if (holder.address < ctx.registers.size() &&
+                ctx.registers[holder.address] == holder.value) {
+                ctx.SetRegister(holder.address, read.Word(holder.value));
+            }
+            DropHold(PlaceholderSlot(holder.value), release);
+        }
+        registers.clear();
+        if (params) {
+            for (u32 k = 0; k < pending.count; ++k) {
+                ctx.params[k] = read.Word(Placeholder(pending.slot, k));
+            }
+        }
+        DropPending(ctx);
+    }
+
+    /// The registers that hold list words.
+    [[nodiscard]] std::span<const Holder> Registers() const {
+        return registers;
+    }
+
+private:
+    struct Pending {
+        u32 slot{};
+        u32 count{};
+        bool active{};
+    };
+
+    [[nodiscard]] bool TakesPlaceholders(std::span<const u32> params) const {
+        for (u32 k = 0; k < pending.count; ++k) {
+            if (params[k] != Placeholder(pending.slot, k)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    template <typename Context>
+    void DropPending(Context& ctx) {
+        if (!pending.active) {
+            return;
+        }
+        pending.active = false;
+        DropHold(pending.slot, [&ctx](u32 slot) { ctx.Release(slot); });
+    }
+
+    /// Whether the call's macro may read a data RAM word or register that holds a list word.
+    template <typename Context>
+    [[nodiscard]] bool MayReadHeld(Context& ctx, const DataRamWords& channel) {
+        const auto& reads = cache.Get(ctx.code, ctx.generation, ctx.start);
+        return Nx2ListIndirect::MayRead(reads.data_ram_known, reads.data_ram, channel.words) ||
+               Nx2ListIndirect::MayRead(reads.registers_known, reads.registers, registers);
+    }
+
+    /// The dry run of the call with `params` (tagged if `tagged`), the data RAM and the
+    /// registers with their holders.
+    template <typename Context>
+    void DryRun(Context& ctx, const DataRamWords& channel, std::span<const u32> params, bool tagged,
+                TaggedRun& run) {
+        params_tagged.assign(params.size(), static_cast<u8>(tagged ? 1 : 0));
+        RunTagged(
+            ctx.code, ctx.start, params, std::span<const u8>{params_tagged},
+            [&](u32 word) -> std::pair<u32, bool> {
+                const u32 value = ctx.data_ram[word];
+                const auto it = std::ranges::find(channel.words, word, &Holder::address);
+                return {value, it != channel.words.end() && it->value == value};
+            },
+            [&](u32 address) -> std::pair<u32, bool> {
+                if (address >= ctx.registers.size()) {
+                    return {0U, false};
+                }
+                const u32 value = ctx.registers[address];
+                const auto it = std::ranges::find(registers, address, &Holder::address);
+                return {value, it != registers.end() && it->value == value};
+            },
+            decoded, run);
+    }
+
+    /// Whether every tagged value the run emits lands where the back takes it over: an inline
+    /// QMD grid word (the back dispatches from the slot) or a word of a linear one-line inline
+    /// upload the front can place (the back patches it into constant buffers). The data RAM
+    /// keeps the others. Notes where each such upload word lands in `owed`.
+    template <typename Context>
+    [[nodiscard]] bool Places(Context& ctx, const TaggedRun& run) {
+        owed.assign(run.emits.size(), 0);
+        UploadState upload = ctx.upload;
+        const auto reg = [&](size_t before, u32 method) {
+            for (size_t i = before; i-- > 0;) {
+                if (run.emits[i].address == method) {
+                    return run.emits[i].value;
+                }
+            }
+            return method < ctx.registers.size() ? ctx.registers[method] : 0U;
+        };
+        for (size_t i = 0; i < run.emits.size(); ++i) {
+            const TaggedWrite& emit = run.emits[i];
+            if (emit.address >= 0x45 && emit.address <= 0x48) {
+                place_reason = Reason::Upload; // FrontApply loads code and bindings
+                return false;
+            }
+            if (emit.address == UploadData && emit.tagged) {
+                // As Upload::State::ProcessData writes a word of a linear upload of one line.
+                if (!upload.linear || reg(i, UploadLineCount) != 1 ||
+                    u64{upload.words} * 4 + 4 > upload.size) {
+                    place_reason = Reason::Sink;
+                    return false;
+                }
+                const u64 destination =
+                    ((u64{reg(i, UploadAddressHigh)} << 32) | reg(i, UploadAddressLow)) +
+                    u64{upload.words} * 4;
+                const std::optional<u64> device = ctx.DeviceWord(destination);
+                if (!device) {
+                    place_reason = Reason::Sink;
+                    return false;
+                }
+                owed[i] = *device;
+            } else if (emit.tagged &&
+                       (emit.address < InlineQmdGridFirst || emit.address > InlineQmdGridLast)) {
+                place_reason = Reason::Sink;
+                return false;
+            }
+            NoteUploadMethod(upload, emit.address, emit.value,
+                             [&](u32 method) { return reg(i, method); });
+        }
+        return true;
+    }
+
+    /// Applies the run: its data RAM stores, its emits through the engine, and where list words
+    /// are now.
+    template <typename Context>
+    void Commit(Context& ctx, DataRamWords& channel, const TaggedRun& run) {
+        const auto release = [&ctx](u32 slot) { ctx.Release(slot); };
+        for (const TaggedWrite& store : run.data_ram) {
+            ctx.data_ram[store.address] = store.value;
+            Hold(channel.words, store.address, store.value, store.tagged, release);
+        }
+        for (size_t i = 0; i < run.emits.size(); ++i) {
+            const TaggedWrite& emit = run.emits[i];
+            ctx.Emit(emit.address, emit.value);
+            if (emit.address == UploadData && emit.tagged) {
+                ctx.SendOwed(owed[i], emit.value);
+            }
+            if (emit.tagged || !registers.empty()) {
+                Hold(registers, emit.address, emit.value, emit.tagged, release);
+            }
+        }
+    }
+
+    std::vector<Holder> registers;
+    Pending pending;
+    ReadsCache cache;
+    std::vector<TuringMacroInterpreter::Decoded> decoded;
+    std::vector<u8> params_tagged;
+    std::vector<u64> owed;
+    Reason place_reason{};
+};
+
+} // namespace Tegra::Nx2ListIndirect
diff --git a/src/video_core/nx2_list_indirect_stats.h b/src/video_core/nx2_list_indirect_stats.h
new file mode 100644
index 000000000..7940b0215
--- /dev/null
+++ b/src/video_core/nx2_list_indirect_stats.h
@@ -0,0 +1,237 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <map>
+#include <span>
+#include <string>
+
+#include <fmt/format.h>
+#include <fmt/ranges.h>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "video_core/nx2_list_indirect.h"
+#include "video_core/nx2_profile.h"
+
+// TEST: what Nx2ListIndirect did, logged every 10 s by the front with EDEN_NX2_GPU_PROFILE or
+// EDEN_NX2_LIST_INDIRECT_CHECK:
+// - the GPU-written lists the front took without waiting for their writers, by what takes them
+//   (the compute macro method), and the lists it read as before, by why;
+// - the times it read list words back after all (waits the profile counts as "list copy
+//   writers"), how long it waited, and why;
+// - on the back: snapshots, indirect dispatches, grids read back, owed words and the dispatches
+//   whose constant buffers got them.
+// EDEN_NX2_LIST_INDIRECT_CHECK also has the front read every list it takes as before (it waits for
+// the list's writers, as the old path does), and the back compare what the host GPU used, read
+// back, with what the old path would have used: the slot's words with the list's (snapshot), the
+// group counts the dispatch took with the grid the old path dispatches (dispatch), the words
+// copied over a constant buffer's placeholders with the list's (patch), the words read back with
+// the list's (read), and guest memory with the placeholder an inline upload just wrote there
+// (owed: the patch takes over only words guest memory holds). Differences must stay 0; the first
+// ones are logged. It counts the dispatches the old path would have skipped (an empty grid: the
+// indirect one dispatches no groups) and widths over 31 bits (the old path drops the top bit),
+// which differ only on the CPU.
+namespace Tegra::Nx2ListIndirect::Stats {
+
+// A plain flag: checked at every list the host GPU takes over.
+inline bool g_check = std::getenv("EDEN_NX2_LIST_INDIRECT_CHECK") != nullptr;
+
+/// Called by VideoCore::CreateGPU: static initialization runs before the frontend loads
+/// nx2_switches.txt, so a switch set only there takes effect from that point on.
+inline void ReadSwitch() {
+    g_check = std::getenv("EDEN_NX2_LIST_INDIRECT_CHECK") != nullptr;
+}
+
+[[nodiscard]] inline bool Enabled() {
+    return g_check || VideoCommon::Nx2Profile::Enabled();
+}
+
+/// Why a GPU-written list took the old path (the front read its words).
+enum class Kept : u32 {
+    Off,       ///< EDEN_NX2_LIST_INDIRECT=0, the split without macros on its front, no slots
+    NotCall,   ///< Not all the parameters of a compute macro call (3D lists, commands, ...)
+    Placement, ///< Not on one mapped page, or map changes the back has yet to run
+    NoSlot,    ///< Every slot held
+    Refused,   ///< The engine's front or the call's dry run refused it
+    Count,
+};
+inline constexpr std::array<const char*, static_cast<size_t>(Kept::Count)> kept_names{
+    "off",
+    "not all of a compute macro call's parameters",
+    "not on one mapped page or map changes queued",
+    "no free slot",
+    "the call's dry run refused",
+};
+
+inline constexpr std::array<const char*, static_cast<size_t>(Reason::Count)> reason_names{
+    "a macro used one",      "a dry run failed",        "one went elsewhere",
+    "macro code or binding", "a 3D macro may read one", "the split stopped",
+};
+
+/// The back's comparisons (EDEN_NX2_LIST_INDIRECT_CHECK).
+enum class Check : u32 { Snapshot, Dispatch, Patch, Read, Owed, Count };
+inline constexpr std::array<const char*, static_cast<size_t>(Check::Count)> check_names{
+    "snapshot", "dispatch", "patch", "read", "owed"};
+
+struct Counters {
+    // The front's.
+    std::map<u32, std::array<u64, 2>> taken; ///< By macro method: lists, words
+    std::array<u64, static_cast<size_t>(Kept::Count)> kept{};
+    std::array<u64, static_cast<size_t>(Reason::Count)> concretized{};
+    u64 reads{}; ///< Waits for list words read back
+    u64 slots_read{};
+    u64 read_ns{};
+    std::chrono::steady_clock::time_point last_log{std::chrono::steady_clock::now()};
+    // The back's.
+    std::atomic<u64> snapshots{};
+    std::atomic<u64> slot_dispatches{};
+    std::atomic<u64> grids_read{}; ///< Grids of several slots' words, read back to dispatch
+    std::atomic<u64> owed{};
+    std::atomic<u64> owed_dropped{}; ///< Owed words guest memory no longer held
+    std::atomic<u64> patched_binds{};
+    std::array<std::atomic<u64>, static_cast<size_t>(Check::Count)> compared{};
+    std::array<std::atomic<u64>, static_cast<size_t>(Check::Count)> differ{};
+    std::atomic<u64> unchecked{}; ///< Comparisons dropped: the check buffer was full
+    std::atomic<u64> empty_grids{};
+    std::atomic<u64> wide_grids{};
+    std::atomic<u32> differences_logged{};
+};
+
+[[nodiscard]] inline Counters& Get() {
+    static Counters counters;
+    return counters;
+}
+
+/// The front: a GPU-written list took the old path.
+inline void NoteKept(Kept why) {
+    if (Enabled()) [[unlikely]] {
+        ++Get().kept[static_cast<size_t>(why)];
+    }
+}
+
+/// The front: a list of `words` words the call of compute macro method `method` takes.
+inline void NoteTaken(u32 method, u32 words) {
+    if (Enabled()) [[unlikely]] {
+        auto& entry = Get().taken[method];
+        ++entry[0];
+        entry[1] += words;
+    }
+}
+
+/// The front read every list word about back after all.
+inline void NoteConcretized(Reason reason) {
+    if (Enabled()) [[unlikely]] {
+        ++Get().concretized[static_cast<size_t>(reason)];
+    }
+}
+
+/// The front waited `ns` for the words of `slots` slots.
+inline void NoteRead(size_t slots, u64 ns) {
+    if (Enabled()) [[unlikely]] {
+        ++Get().reads;
+        Get().slots_read += slots;
+        Get().read_ns += ns;
+    }
+}
+
+[[nodiscard]] inline u64 NowNs() {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count());
+}
+
+/// Any thread: `counter` of the back's.
+inline void Count(std::atomic<u64>& counter, u64 amount = 1) {
+    if (Enabled()) [[unlikely]] {
+        counter.fetch_add(amount, std::memory_order_relaxed);
+    }
+}
+
+/// The back: a comparison of `check` for `slot`, the bytes the host GPU used (`got`) against the
+/// ones the old path would have (`expected`).
+inline void NoteCompared(Check check, u32 slot, std::span<const u8> got,
+                         std::span<const u8> expected) {
+    auto& counters = Get();
+    counters.compared[static_cast<size_t>(check)].fetch_add(1, std::memory_order_relaxed);
+    if (std::ranges::equal(got, expected)) {
+        return;
+    }
+    counters.differ[static_cast<size_t>(check)].fetch_add(1, std::memory_order_relaxed);
+    if (counters.differences_logged.fetch_add(1, std::memory_order_relaxed) < 32) {
+        LOG_ERROR(HW_GPU, "Nx2 list indirect check: {} of slot {} differs: {:02x}, expected {:02x}",
+                  check_names[static_cast<size_t>(check)], slot, fmt::join(got, " "),
+                  fmt::join(expected, " "));
+    }
+}
+
+/// The front, every 10 s.
+inline void MaybeLog() {
+    auto& counters = Get();
+    const auto now = std::chrono::steady_clock::now();
+    const double seconds = std::chrono::duration<double>(now - counters.last_log).count();
+    if (seconds < 10.0) {
+        return;
+    }
+    counters.last_log = now;
+    u64 taken = 0;
+    u64 taken_words = 0;
+    std::string by_method;
+    for (const auto& [method, entry] : counters.taken) {
+        taken += entry[0];
+        taken_words += entry[1];
+        by_method += fmt::format("{}compute {:#x} {} ({} words)", by_method.empty() ? "" : ", ",
+                                 method, entry[0], entry[1]);
+    }
+    u64 kept = 0;
+    std::string why_kept;
+    for (size_t i = 0; i < counters.kept.size(); ++i) {
+        kept += counters.kept[i];
+        why_kept +=
+            fmt::format("{}{} {}", why_kept.empty() ? "" : ", ", kept_names[i], counters.kept[i]);
+    }
+    std::string why_read;
+    for (size_t i = 0; i < counters.concretized.size(); ++i) {
+        why_read += fmt::format("{}{} {}", why_read.empty() ? "" : ", ", reason_names[i],
+                                counters.concretized[i]);
+    }
+    const auto take = [](std::atomic<u64>& counter) {
+        return counter.exchange(0, std::memory_order_relaxed);
+    };
+    LOG_INFO(HW_GPU,
+             "list indirect {:.1f}s: GPU-written lists taken without waiting {} ({} words): {} | "
+             "read as before {}: {} | list words read back {} times ({} slots, {:.1f} ms), all "
+             "of them after: {} | back: snapshots {}, indirect dispatches {}, grids read back {}, "
+             "owed words {} ({} overwritten), dispatches given owed words {}",
+             seconds, taken, taken_words, by_method.empty() ? "-" : by_method, kept, why_kept,
+             counters.reads, counters.slots_read, static_cast<double>(counters.read_ns) / 1e6,
+             why_read, take(counters.snapshots), take(counters.slot_dispatches),
+             take(counters.grids_read), take(counters.owed), take(counters.owed_dropped),
+             take(counters.patched_binds));
+    if (g_check) {
+        std::string checks;
+        for (size_t i = 0; i < counters.compared.size(); ++i) {
+            checks += fmt::format("{}{} {} ({} differ)", checks.empty() ? "" : ", ", check_names[i],
+                                  take(counters.compared[i]), take(counters.differ[i]));
+        }
+        LOG_INFO(HW_GPU,
+                 "list indirect check {:.1f}s: compared {}; unchecked {} | dispatches the old "
+                 "path skips (empty grid) {}, widths over 31 bits {}",
+                 seconds, checks, take(counters.unchecked), take(counters.empty_grids),
+                 take(counters.wide_grids));
+    }
+    counters.taken.clear();
+    counters.kept = {};
+    counters.concretized = {};
+    counters.reads = 0;
+    counters.slots_read = 0;
+    counters.read_ns = 0;
+}
+
+} // namespace Tegra::Nx2ListIndirect::Stats
diff --git a/src/video_core/nx2_list_stats.h b/src/video_core/nx2_list_stats.h
new file mode 100644
index 000000000..47532469d
--- /dev/null
+++ b/src/video_core/nx2_list_stats.h
@@ -0,0 +1,580 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <mutex>
+#include <optional>
+#include <span>
+#include <string>
+#include <tuple>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "video_core/nx2.h"
+
+// EDEN_NX2_LIST_STATS: what the front's reads of command lists on GPU-written pages
+// (DmaPusher::ReadGpuWrittenCommands) wait for. For each list its size; for each of its pages how
+// BufferCache::Nx2ReadListCopy served it, the GPU work that last wrote the page (a dispatch's
+// shader, a copy engine copy's source, or draws) and whether the copy held other bytes than guest
+// memory; for each copy the front waited for: how long, how long before the back had recorded it,
+// how much the back still had to run (and of that, not yet published) and whether other channels
+// had lists queued. Every 10 s the front logs the counts.
+//
+// EDEN_NX2_LIST_VERIFY: each list read so is read again as the front read lists before it tracked
+// the words GPU work wrote (after every dispatch and copy sent so far, from the pages' whole
+// copies, or drained and flushed) and, when the two differ, drained and flushed as well, which
+// tells the stale read. Differences are counted and the first ones logged; the front parses the
+// words read last.
+namespace Tegra::Nx2ListStats {
+
+// Plain flags: checked at every GPU-written list and buffer write mark.
+inline bool g_enabled = std::getenv("EDEN_NX2_LIST_STATS") != nullptr;
+inline bool g_verify = std::getenv("EDEN_NX2_LIST_VERIFY") != nullptr;
+
+/// Called by VideoCore::CreateGPU: static initialization runs before the frontend loads
+/// nx2_switches.txt, so a switch set only there takes effect from that point on.
+inline void ReadSwitches() {
+    g_enabled = std::getenv("EDEN_NX2_LIST_STATS") != nullptr;
+    g_verify = std::getenv("EDEN_NX2_LIST_VERIFY") != nullptr;
+}
+
+[[nodiscard]] inline bool Any() {
+    return g_enabled || g_verify;
+}
+
+[[nodiscard]] inline u64 NowNs() {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count());
+}
+
+inline constexpr u64 PageBytes = u64{1} << Nx2WrittenPageBits;
+
+/// How BufferCache::Nx2ReadListCopy served a list's bytes on one page.
+enum class Served : u32 {
+    PageSynced, ///< From guest memory: the front flushed the page, no GPU work wrote it since
+    WordsClean, ///< From guest memory: no GPU work wrote the list's words since the flush
+    CopyReady,  ///< From the page's copy, which the GPU had finished
+    CopyWaited, ///< From the page's copy, once the GPU finished it
+    Unknown,    ///< Nowhere: the front drains and flushes
+    Count,
+};
+
+inline constexpr std::array<const char*, static_cast<size_t>(Served::Count)> served_names{
+    "page synced", "words clean", "copy ready", "copy waited", "unknown",
+};
+
+/// The GPU work that last wrote a command list page (BufferCache::Nx2NoteListWrite).
+enum class Writer : u32 {
+    None,     ///< No write noted since the stats began
+    Dispatch, ///< A compute dispatch: the id is its shader's hash
+    Copy,     ///< A copy engine copy: the id is its source GPU address
+    Draw,     ///< Draws and the other GPU writes
+    Count,
+};
+
+inline constexpr std::array<const char*, static_cast<size_t>(Writer::Count)> writer_names{
+    "none",
+    "dispatch",
+    "copy",
+    "draw",
+};
+
+struct WriterTag {
+    Writer writer{Writer::Draw};
+    u64 id{};
+};
+
+/// The back: the dispatch or copy the GPU writes noted now come from.
+inline thread_local WriterTag t_writer{};
+
+/// The back, around a dispatch or a copy engine copy: tags the GPU writes noted meanwhile.
+class WriterScope {
+public:
+    explicit WriterScope(Writer writer, u64 id) : previous{t_writer} {
+        t_writer = WriterTag{writer, id};
+    }
+    ~WriterScope() {
+        t_writer = previous;
+    }
+    WriterScope(const WriterScope&) = delete;
+    WriterScope& operator=(const WriterScope&) = delete;
+
+private:
+    WriterTag previous;
+};
+
+/// What Nx2ReadListCopy told about its last read where its result does not (NoteServed).
+struct ServedDetail {
+    bool valid{};
+    Served served{Served::Unknown};
+    u64 wait_start_ns{}; ///< CopyWaited: when the front started to wait
+    u64 waited_ns{};
+};
+inline thread_local ServedDetail t_served{};
+
+/// The front, in Nx2ReadListCopy: how it served the read.
+inline void NoteServed(Served served, u64 wait_start_ns = 0, u64 waited_ns = 0) {
+    if (Any()) {
+        t_served = ServedDetail{true, served, wait_start_ns, waited_ns};
+    }
+}
+
+/// The front, while EDEN_NX2_LIST_VERIFY reads a list as before: Nx2ReadListCopy serves guest
+/// memory only for pages flushed and written by no GPU work since, else the page's whole copy.
+inline thread_local bool t_reference{};
+
+class ReferenceScope {
+public:
+    ReferenceScope() {
+        t_reference = true;
+    }
+    ~ReferenceScope() {
+        t_reference = false;
+    }
+    ReferenceScope(const ReferenceScope&) = delete;
+    ReferenceScope& operator=(const ReferenceScope&) = delete;
+};
+
+inline constexpr size_t ChannelSlots = 16;
+/// Command lists submitted to the GPU thread (ThreadManager::SubmitList) that it has not taken
+/// yet, by channel.
+inline std::array<std::atomic<s32>, ChannelSlots> g_queued_lists{};
+
+[[nodiscard]] inline size_t ChannelSlot(s32 channel) {
+    return static_cast<size_t>(static_cast<u32>(channel)) % ChannelSlots;
+}
+
+/// Any thread: a list of `channel` was queued for the GPU thread (`delta` 1) or taken (-1).
+inline void NoteListQueued(s32 channel, s32 delta) {
+    if (g_enabled) {
+        g_queued_lists[ChannelSlot(channel)].fetch_add(delta, std::memory_order_relaxed);
+    }
+}
+
+/// Whether lists of channels other than `channel` wait for the GPU thread.
+[[nodiscard]] inline bool OtherChannelsQueued(s32 channel) {
+    const size_t own = ChannelSlot(channel);
+    for (size_t slot = 0; slot < ChannelSlots; ++slot) {
+        if (slot != own && g_queued_lists[slot].load(std::memory_order_relaxed) > 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+struct Waits {
+    u64 reads{};
+    u64 waits{};
+    u64 wait_ns{};
+
+    void Add(bool waited, u64 ns) {
+        ++reads;
+        if (waited) {
+            ++waits;
+            wait_ns += ns;
+        }
+    }
+};
+
+struct PageInfo {
+    WriterTag writer{Writer::None, 0};
+    u32 write_begin{}; ///< The last GPU write's bytes on the page
+    u32 write_end{};
+    u64 write_size{};        ///< The last GPU write's whole size
+    u64 copy_ns{};           ///< When the back recorded the page's last copy
+    Waits waits;             ///< This period's reads
+    u32 list_begin{~u32{0}}; ///< The bytes of the page this period's lists read
+    u32 list_end{};
+};
+
+struct WriterStats {
+    WriterTag writer;
+    Waits waits;  ///< This period's reads of the pages it wrote last
+    u64 writes{}; ///< This period's GPU writes to command list pages
+    u64 bytes{};  ///< Their bytes on those pages
+};
+
+/// How a list differed from its read as before (EDEN_NX2_LIST_VERIFY).
+enum class Difference : u32 {
+    OldStale,  ///< The drained read matches the new read: the read as before was stale
+    NewStale,  ///< The drained read matches the read as before: the new read was stale
+    AllDiffer, ///< All three differ
+    Drained,   ///< The read as before drained and flushed: the new read was stale
+    Count,
+};
+
+inline constexpr std::array<const char*, static_cast<size_t>(Difference::Count)> difference_names{
+    "the read as before was stale",
+    "the new read was stale",
+    "all three differ",
+    "the new read differs from the drained one",
+};
+
+/// One page of the list the front reads, for EDEN_NX2_LIST_VERIFY's log.
+struct ListPart {
+    u64 page{};
+    u32 offset{};
+    u32 size{};
+    Served served{Served::Unknown};
+};
+
+inline constexpr std::array<u64, 5> list_size_limits{16, 64, 256, 1024, 4096};
+inline constexpr std::array<u64, 4> wait_limits_us{100, 250, 500, 1000};
+
+/// The counts of one logging period.
+struct Period {
+    u64 lists{};
+    u64 list_words{};
+    std::array<u64, list_size_limits.size() + 1> list_sizes{};
+    std::array<u64, static_cast<size_t>(Served::Count)> served{};
+    std::array<Waits, static_cast<size_t>(Writer::Count)> by_writer{};
+    u64 after_sync{}; ///< Reads that first waited for the work before the last sync
+    u64 wait_ns{};
+    u64 wait_max_ns{};
+    std::array<u64, wait_limits_us.size() + 1> wait_sizes{};
+    u64 copies_compared{};
+    u64 copies_equal{};
+    u64 waits_backlog{}; ///< Copy waits the back had work for
+    u64 backlog_words{};
+    u64 waits_unpublished{}; ///< Copy waits with work the back did not see yet
+    u64 unpublished_words{};
+    u64 waits_other_channels{};
+    u64 waits_recorded{}; ///< Copy waits whose copy's record time is known
+    u64 since_recorded_ns{};
+
+    u64 verified{};
+    u64 verified_drained{}; ///< Read as before by draining and flushing
+    u64 differ{};
+    u64 differ_words{};
+    std::array<u64, static_cast<size_t>(Difference::Count)> differences{};
+};
+
+struct State {
+    std::mutex mutex;
+    std::unordered_map<u64, PageInfo> pages;
+    std::unordered_map<u64, WriterStats> writers;
+    std::vector<ListPart> parts; ///< The pages of the list the front reads
+    Period period;
+    u64 verified_total{};
+    u64 differ_total{};
+    u32 differ_logged{};
+    std::chrono::steady_clock::time_point last_log{std::chrono::steady_clock::now()};
+};
+
+inline State& Get() {
+    static State state;
+    return state;
+}
+
+[[nodiscard]] inline u64 WriterKey(const WriterTag& tag) {
+    return (static_cast<u64>(tag.writer) << 60) ^ tag.id;
+}
+
+[[nodiscard]] inline std::string WriterText(const WriterTag& tag) {
+    switch (tag.writer) {
+    case Writer::Dispatch:
+        return fmt::format("dispatch {:#018x}", tag.id);
+    case Writer::Copy:
+        return fmt::format("copy from {:#x}", tag.id);
+    default:
+        return writer_names[static_cast<size_t>(tag.writer)];
+    }
+}
+
+/// The index of the first of `limits` `value` does not exceed, else limits.size().
+[[nodiscard]] inline size_t Bucket(u64 value, std::span<const u64> limits) {
+    size_t bucket = 0;
+    while (bucket < limits.size() && value > limits[bucket]) {
+        ++bucket;
+    }
+    return bucket;
+}
+
+[[nodiscard]] inline double Ms(u64 ns) {
+    return static_cast<double>(ns) / 1e6;
+}
+
+[[nodiscard]] inline double Average(u64 total, u64 count, double unit) {
+    return count == 0 ? 0.0 : static_cast<double>(total) / static_cast<double>(count) / unit;
+}
+
+/// The back: GPU work wrote [device_addr, device_addr + size) over the command list page at
+/// `page_addr` (BufferCache::Nx2NoteListWrite).
+inline void NoteWrite(u64 page_addr, u64 device_addr, u64 size) {
+    const u64 begin = (std::max)(device_addr, page_addr) - page_addr;
+    const u64 end = (std::min)(device_addr + size, page_addr + PageBytes) - page_addr;
+    const WriterTag tag = t_writer;
+    State& state = Get();
+    std::scoped_lock lock{state.mutex};
+    PageInfo& page = state.pages[page_addr];
+    page.writer = tag;
+    page.write_begin = static_cast<u32>(begin);
+    page.write_end = static_cast<u32>(end);
+    page.write_size = size;
+    WriterStats& stats = state.writers[WriterKey(tag)];
+    stats.writer = tag;
+    ++stats.writes;
+    stats.bytes += end - begin;
+}
+
+/// The back recorded the copy of the command list page at `page_addr` (Nx2CopyListPages).
+inline void NoteCopy(u64 page_addr) {
+    const u64 now = NowNs();
+    State& state = Get();
+    std::scoped_lock lock{state.mutex};
+    state.pages[page_addr].copy_ns = now;
+}
+
+inline void LogStats(const State& state, double seconds) {
+    const Period& counts = state.period;
+    const auto writer_reads = [&counts](Writer kind) {
+        const Waits& entry = counts.by_writer[static_cast<size_t>(kind)];
+        return fmt::format("{} {}/{}/{:.1f}", writer_names[static_cast<size_t>(kind)], entry.reads,
+                           entry.waits, Ms(entry.wait_ns));
+    };
+    const u64 copy_waits = counts.served[static_cast<size_t>(Served::CopyWaited)];
+    LOG_INFO(
+        HW_GPU,
+        "list stats {:.1f}s: {} lists of {} words (up to 16 words {}, 64 {}, 256 {}, 1024 {}, "
+        "4096 {}, more {}) | page reads: page synced {}, words clean {}, copy ready {}, copy "
+        "waited {}, unknown {}; after a sync wait {} | copy waits {:.1f} ms, average {:.0f} "
+        "us, max {:.0f} us (up to 100 us {}, 250 {}, 500 {}, 1000 {}, more {}) | by the "
+        "page's last writer (reads/waits/ms): {}, {}, {}, {} | copies equal to guest memory "
+        "{} of {} | at copy waits: the back had work {} (average {:.0f} words), not yet "
+        "published {} (average {:.0f} words), other channels had lists queued {}, the copy "
+        "was recorded {:.0f} us before on average ({} known)",
+        seconds, counts.lists, counts.list_words, counts.list_sizes[0], counts.list_sizes[1],
+        counts.list_sizes[2], counts.list_sizes[3], counts.list_sizes[4], counts.list_sizes[5],
+        counts.served[0], counts.served[1], counts.served[2], counts.served[3], counts.served[4],
+        counts.after_sync, Ms(counts.wait_ns), Average(counts.wait_ns, copy_waits, 1e3),
+        static_cast<double>(counts.wait_max_ns) / 1e3, counts.wait_sizes[0], counts.wait_sizes[1],
+        counts.wait_sizes[2], counts.wait_sizes[3], counts.wait_sizes[4],
+        writer_reads(Writer::Dispatch), writer_reads(Writer::Copy), writer_reads(Writer::Draw),
+        writer_reads(Writer::None), counts.copies_equal, counts.copies_compared,
+        counts.waits_backlog, Average(counts.backlog_words, counts.waits_backlog, 1.0),
+        counts.waits_unpublished, Average(counts.unpublished_words, counts.waits_unpublished, 1.0),
+        counts.waits_other_channels, Average(counts.since_recorded_ns, counts.waits_recorded, 1e3),
+        counts.waits_recorded);
+
+    std::vector<const WriterStats*> writers;
+    for (const auto& entry : state.writers) {
+        writers.push_back(&entry.second);
+    }
+    std::ranges::sort(writers, [](const WriterStats* lhs, const WriterStats* rhs) {
+        return std::tie(lhs->waits.wait_ns, lhs->waits.reads, lhs->writes) >
+               std::tie(rhs->waits.wait_ns, rhs->waits.reads, rhs->writes);
+    });
+    std::string writers_text;
+    for (size_t i = 0; i < writers.size() && i < 8; ++i) {
+        const WriterStats& stats = *writers[i];
+        writers_text += fmt::format(
+            "{}{}: {} reads, {} waits in {:.1f} ms, {} writes of {} bytes on list pages",
+            writers_text.empty() ? "" : "; ", WriterText(stats.writer), stats.waits.reads,
+            stats.waits.waits, Ms(stats.waits.wait_ns), stats.writes, stats.bytes);
+    }
+    if (!writers_text.empty()) {
+        LOG_INFO(HW_GPU, "list stats writers: {}", writers_text);
+    }
+
+    std::vector<std::pair<u64, const PageInfo*>> pages;
+    for (const auto& entry : state.pages) {
+        if (entry.second.waits.reads != 0) {
+            pages.emplace_back(entry.first, &entry.second);
+        }
+    }
+    std::ranges::sort(pages, [](const auto& lhs, const auto& rhs) {
+        return std::tie(lhs.second->waits.wait_ns, lhs.second->waits.reads) >
+               std::tie(rhs.second->waits.wait_ns, rhs.second->waits.reads);
+    });
+    std::string pages_text;
+    for (size_t i = 0; i < pages.size() && i < 8; ++i) {
+        const PageInfo& info = *pages[i].second;
+        pages_text += fmt::format(
+            "{}{:#x}: {} reads, {} waits in {:.1f} ms, lists at {:#x}-{:#x}, last written "
+            "{:#x}-{:#x} (of {} bytes) by {}",
+            pages_text.empty() ? "" : "; ", pages[i].first, info.waits.reads, info.waits.waits,
+            Ms(info.waits.wait_ns), info.list_begin, info.list_end, info.write_begin,
+            info.write_end, info.write_size, WriterText(info.writer));
+    }
+    if (!pages_text.empty()) {
+        LOG_INFO(HW_GPU, "list stats pages: {}", pages_text);
+    }
+}
+
+inline void LogVerify(const State& state, double seconds) {
+    const Period& counts = state.period;
+    LOG_INFO(HW_GPU,
+             "list verify {:.1f}s: {} lists read again ({} drained and flushed), {} differ in {} "
+             "words: {} {}, {} {}, {} {}, {} {}; since the start {} of {} differ",
+             seconds, counts.verified, counts.verified_drained, counts.differ, counts.differ_words,
+             difference_names[0], counts.differences[0], difference_names[1], counts.differences[1],
+             difference_names[2], counts.differences[2], difference_names[3], counts.differences[3],
+             state.differ_total, state.verified_total);
+}
+
+/// The front: logs every 10 s.
+inline void MaybeLog() {
+    State& state = Get();
+    const auto now = std::chrono::steady_clock::now();
+    std::scoped_lock lock{state.mutex};
+    const double seconds = std::chrono::duration<double>(now - state.last_log).count();
+    if (seconds < 10.0) {
+        return;
+    }
+    state.last_log = now;
+    if (g_enabled) {
+        LogStats(state, seconds);
+    }
+    if (g_verify) {
+        LogVerify(state, seconds);
+    }
+    state.period = {};
+    state.writers.clear();
+    for (auto& entry : state.pages) {
+        entry.second.waits = {};
+        entry.second.list_begin = ~u32{0};
+        entry.second.list_end = 0;
+    }
+}
+
+/// The front starts reading a list of `words` on GPU-written pages.
+inline void BeginList(u32 words) {
+    MaybeLog();
+    t_served = {};
+    State& state = Get();
+    std::scoped_lock lock{state.mutex};
+    state.parts.clear();
+    ++state.period.lists;
+    state.period.list_words += words;
+    ++state.period.list_sizes[Bucket(words, list_size_limits)];
+}
+
+/// The front read `size` bytes at `offset` of the command list page at `page_addr`. `result`: as
+/// Nx2ReadListCopy's result tells (PageSynced, CopyReady or Unknown; NoteServed tells more).
+/// `after_sync`: it first waited for the work before the last sync (a page draws write).
+/// `copy_equal`: for a read from the copy, whether guest memory held the same bytes. `backlog`
+/// and `unpublished`: the ring words the back had not run before the read, and of them those it
+/// did not see. `channel`: the list's.
+inline void NoteRead(u64 page_addr, u32 offset, u32 size, Served result, bool after_sync,
+                     std::optional<bool> copy_equal, u64 backlog, u64 unpublished, s32 channel) {
+    const ServedDetail detail = t_served;
+    t_served = {};
+    const Served served = result == Served::Unknown || !detail.valid ? result : detail.served;
+    const bool waited = served == Served::CopyWaited;
+    const u64 wait_ns = waited ? detail.waited_ns : 0;
+    const bool other_channels = waited && OtherChannelsQueued(channel);
+    State& state = Get();
+    std::scoped_lock lock{state.mutex};
+    state.parts.push_back(ListPart{page_addr, offset, size, served});
+    if (!g_enabled) {
+        return;
+    }
+    Period& counts = state.period;
+    ++counts.served[static_cast<size_t>(served)];
+    counts.after_sync += after_sync ? 1 : 0;
+    PageInfo& page = state.pages[page_addr];
+    page.waits.Add(waited, wait_ns);
+    page.list_begin = (std::min)(page.list_begin, offset);
+    page.list_end = (std::max)(page.list_end, offset + size);
+    counts.by_writer[static_cast<size_t>(page.writer.writer)].Add(waited, wait_ns);
+    if (page.writer.writer != Writer::None) {
+        WriterStats& stats = state.writers[WriterKey(page.writer)];
+        stats.writer = page.writer;
+        stats.waits.Add(waited, wait_ns);
+    }
+    if (copy_equal) {
+        ++counts.copies_compared;
+        counts.copies_equal += *copy_equal ? 1 : 0;
+    }
+    if (!waited) {
+        return;
+    }
+    counts.wait_ns += wait_ns;
+    counts.wait_max_ns = (std::max)(counts.wait_max_ns, wait_ns);
+    ++counts.wait_sizes[Bucket(wait_ns / 1000, wait_limits_us)];
+    if (backlog != 0) {
+        ++counts.waits_backlog;
+        counts.backlog_words += backlog;
+    }
+    if (unpublished != 0) {
+        ++counts.waits_unpublished;
+        counts.unpublished_words += unpublished;
+    }
+    counts.waits_other_channels += other_channels ? 1 : 0;
+    if (page.copy_ns != 0 && page.copy_ns <= detail.wait_start_ns) {
+        ++counts.waits_recorded;
+        counts.since_recorded_ns += detail.wait_start_ns - page.copy_ns;
+    }
+}
+
+/// EDEN_NX2_LIST_VERIFY: the front read the list at `address` as `parsed`, then as before as
+/// `reference` (`reference_drained`: by draining and flushing) and, when those differ, drained
+/// and flushed as `drained` (else empty).
+inline void NoteVerify(u64 address, std::span<const u32> parsed, std::span<const u32> reference,
+                       std::span<const u32> drained, bool reference_drained) {
+    u64 differing = 0;
+    size_t first = parsed.size();
+    for (size_t i = 0; i < parsed.size() && i < reference.size(); ++i) {
+        if (parsed[i] != reference[i]) {
+            ++differing;
+            first = (std::min)(first, i);
+        }
+    }
+    State& state = Get();
+    std::scoped_lock lock{state.mutex};
+    Period& counts = state.period;
+    ++counts.verified;
+    ++state.verified_total;
+    counts.verified_drained += reference_drained ? 1 : 0;
+    if (differing == 0) {
+        return;
+    }
+    Difference kind = Difference::Drained;
+    if (!reference_drained) {
+        if (std::ranges::equal(drained, parsed)) {
+            kind = Difference::OldStale;
+        } else if (std::ranges::equal(drained, reference)) {
+            kind = Difference::NewStale;
+        } else {
+            kind = Difference::AllDiffer;
+        }
+    }
+    ++counts.differ;
+    ++state.differ_total;
+    counts.differ_words += differing;
+    ++counts.differences[static_cast<size_t>(kind)];
+    if (state.differ_logged >= 32) {
+        return;
+    }
+    ++state.differ_logged;
+    std::string parts_text;
+    for (const ListPart& part : state.parts) {
+        const auto it = state.pages.find(part.page);
+        const PageInfo info = it != state.pages.end() ? it->second : PageInfo{};
+        parts_text += fmt::format("{}{:#x}+{:#x} ({} bytes) {}, last written {:#x}-{:#x} by {}",
+                                  parts_text.empty() ? "" : "; ", part.page, part.offset, part.size,
+                                  served_names[static_cast<size_t>(part.served)], info.write_begin,
+                                  info.write_end, WriterText(info.writer));
+    }
+    LOG_WARNING(HW_GPU,
+                "list verify: list at {:#x} ({} words) differs from its read as before in {} "
+                "words, the first word {}: {:#010x}, as before {:#010x}{}: {}; its pages: {}",
+                address, parsed.size(), differing, first, parsed[first], reference[first],
+                drained.size() > first ? fmt::format(", drained {:#010x}", drained[first])
+                                       : std::string{},
+                difference_names[static_cast<size_t>(kind)], parts_text);
+}
+
+} // namespace Tegra::Nx2ListStats
