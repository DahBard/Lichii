+std::vector<u8> RandomBytes(size_t size, u32 seed) {
+    std::mt19937 engine{seed};
+    std::vector<u8> bytes(size);
+    for (u8& byte : bytes) {
+        byte = static_cast<u8>(engine());
+    }
+    return bytes;
