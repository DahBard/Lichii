+
+bool HasControls(const QString& value) {
+    for (const auto ch : value) {
+        if (ch.category() == QChar::Other_Control && ch != QLatin1Char('\t') &&
+            ch != QLatin1Char('\n') && ch != QLatin1Char('\r')) {
+            return true;
+        }
+    }
+    return false;
+}
