+// LICHII_TUNED4_DMA_READS=1: what tuned4's front waited for before a macro DMA read (#345's
+// precise reads, with its shadow of queued constant buffer words and the mixed reads of
+// LICHII_DMA_MIXED_READS). Returns the words when it answered them without the back, else
+// nothing: memory holds them once this returns.
+std::span<const u32> Maxwell3D::FrontDmaReadTuned4(VideoCommon::GpuSplit& split, FrontState& fs,
+                                                   u32 macro, u32 method, GPUVAddr source,
+                                                   u32 words) {
+    const size_t read_bytes = size_t{words} * sizeof(u32);
+    // Wait only for queued work that may write the words: compute, copies, untracked
+    // writes and overlapping inline constant buffer data. Ocarina of Time reads ~20,000 times a
+    // second; a full drain each time kept the two GPU threads waiting on each other. Every 4096th
+    // read still drains and checks for GPU-written data, which turns the precise reads off.
+    static bool precise_disabled{};
+    const bool precise = !precise_disabled &&
+                         !VideoCommon::QueryDma::TraceEnabled() &&
+                         !Tegra::Nx2CmdPageDiag::g_enabled &&
+                         FrontRegister(split, fs,
+                                       MAXWELL3D_REG_INDEX(transform_feedback_enabled)) == 0 &&
+                         (++fs.dma_reads & 4095) != 0;
+    static thread_local std::vector<u32> shadow_words;
+    shadow_words.clear();
+    if (precise) {
+        const u64 target = split.ReadReadyPosition(&memory_manager, source, source + read_bytes);
+        const u64 consumed = split.Consumed();
+        // Constant buffer words sent inline after any other write to them are known here:
+        // read them without waiting for the back to store them.
+        if (target > consumed) {
+            const u64 opaque =
+                split.OpaqueReadyPosition(&memory_manager, source, source + read_bytes);
+            shadow_words.clear();
+            const bool complete = DeviceWords(source, words, [&](u32, std::optional<DAddr> device) {
+                const auto it = device ? fs.cb_shadow.find(*device) : fs.cb_shadow.end();
+                // Only words still queued: memory has the others, maybe rewritten by the CPU.
+                if (it == fs.cb_shadow.end() || it->second.position < opaque ||
+                    it->second.position <= consumed) {
+                    return false;
+                }
+                shadow_words.push_back(it->second.value);
+                return true;
+            });
+            if (!complete) {
+                shadow_words.clear();
+            }
+        }
+        // LICHII_DMA_MIXED_READS (1 default, 2 verify, 0 off): a read the shadow can't answer
+        // whole takes its still-queued constant buffer words from the shadow and the others from
+        // memory, when no queued write may change them: none queued to their 64-byte block, no
+        // untracked writer pending, and their page not GPU-written. In r23 such overlaps were
+        // 94% of Ocarina's macro DMA read waits (~200-240 ms/s of the front).
+        static const int mixed_reads = [] {
+            const char* const value = std::getenv("LICHII_DMA_MIXED_READS");
+            return value != nullptr && value[0] != '\0' ? std::atoi(value) : 1;
+        }();
+        static thread_local std::vector<u32> mixed_words;
+        bool mixed = false;
+        if (target > consumed && shadow_words.empty() && mixed_reads != 0) {
+            mixed_words.clear();
+            const u64 barrier = split.MemoryBarrierPosition();
+            mixed = DeviceWords(source, words, [&](u32 i, std::optional<DAddr> device) {
+                if (!device) {
