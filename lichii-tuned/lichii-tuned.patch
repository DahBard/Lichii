+bool GpuSplit::WaitForWrites(const Tegra::MemoryManager& memory, GPUVAddr address, u64 size) {
+    return WaitFor(std::min(WritesTarget(memory, address, size), write_position),
+                   DrainSite::MacroDmaWrites);
+}
