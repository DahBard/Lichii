+void Dialog::Abort() {
+    if (reply) {
+        auto* pending = reply.data();
+        reply = nullptr;
+        pending->abort();
+        pending->deleteLater();
+    }
+    if (state == State::Searching) {
+        state = State::Editing;
+    }
+}
