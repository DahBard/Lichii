+                if (known->contains(record_key.Hash())) {
+                    ++counts->known;
+                    return [] { return true; };
+                }
+                boost::container::static_vector<Shader::Environment*, Maxwell::MaxShaderProgram>
+                    env_ptrs;
+                for (auto& env : envs) {
+                    env_ptrs.push_back(&env);
+                }
+                auto pipeline = CreateGraphicsPipeline(pools, record_key, MakeSpan(env_ptrs),
+                                                       nullptr, false);
+                if (!pipeline) {
