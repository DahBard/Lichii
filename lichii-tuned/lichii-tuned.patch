+
+struct RecyclerState {
+    std::mutex mutex;
+    std::vector<RecycledImage> images; // oldest first
+    u64 bytes = 0;
+    VmaAllocator closed{}; ///< Torn down: keeps nothing more of it
+};
+
+RecyclerState& Recycler() {
+    static RecyclerState state;
+    return state;
