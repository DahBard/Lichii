--- /dev/null
+++ b/dist/lichii-tuned/ab-11-official-shader-cache.bat
@@ -0,0 +1,6 @@
+@echo off
+rem Official shader handling: boot compiles only the pipelines the last sessions used, and a
+rem pipeline unused for 9000 frames is destroyed (LICHII_KEEP_PIPELINES=0, and
+rem EDEN_NX2_PRELOAD_ALL_PIPELINES=0 over the line in nx2_switches.txt).
+set LICHII_KEEP_PIPELINES=0&& set EDEN_NX2_PRELOAD_ALL_PIPELINES=0
+start "" "%~dp0lichii.exe" %*
diff --git a/dist/lichii-tuned/ab-12-round15-paths.bat b/dist/lichii-tuned/ab-12-round15-paths.bat
new file mode 100644
index 000000000..cda3097f1
--- /dev/null
+++ b/dist/lichii-tuned/ab-12-round15-paths.bat
@@ -0,0 +1,6 @@
+@echo off
+rem Round 16's new shortcuts off, as in round 15, with the perf-trace logging: native bank pages
+rem compared on every bind, texture uploads as before, macro reads that overlap queued writes
+rem drained, and pipelines keyed by every vertex attribute type. If a glitch or a frame-rate change goes away here, one of them caused it.
+set LICHII_BANK_CHECK=0&& set LICHII_TEXTURE_UPLOADS=0&& set LICHII_DMA_MIXED_READS=0&& set LICHII_KEY_ALL_ATTRIBUTES=1&& set EDEN_NX2_GPU_PROFILE=1&& set EDEN_DKB_FRAME_TRACE=1&& set EDEN_NX2_MME_DMA_STATS=1
+start "" "%~dp0lichii.exe" %*
diff --git a/dist/lichii-tuned/ab-13-round16-texture-reads.bat b/dist/lichii-tuned/ab-13-round16-texture-reads.bat
