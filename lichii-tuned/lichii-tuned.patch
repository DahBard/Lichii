diff --git a/src/video_core/renderer_vulkan/heavy_build_slots.h b/src/video_core/renderer_vulkan/heavy_build_slots.h
new file mode 100644
index 0000000000..2f38699f1c
--- /dev/null
+++ b/src/video_core/renderer_vulkan/heavy_build_slots.h
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <condition_variable>
+#include <cstdlib>
+#include <mutex>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/memory_detect.h"
+
+namespace Vulkan {
+
+/// Slots for driver builds of native task/mesh graphics pipelines, which can each take minutes and
+/// gigabytes. Measured on Mesa's Intel driver (ANV 26.2, Arc B580), Ocarina of Time: about 40 of
+/// its cached pipelines are task/mesh pipelines, each 150-180 s and several GB in the compiler; the
+/// boot's pipeline workers built them all at once after a SPIR-V change and the process passed
+/// 73 GB. Other builds don't wait. Default: one slot per 8 GiB of a quarter of the host's RAM (1 to
+/// 8); EDEN_NX2_HEAVY_BUILD_SLOTS=N sets them (0: no limit).
+class HeavyBuildSlots {
+public:
+    /// Holds a slot while alive (none when the limit is off).
+    class Guard {
+    public:
+        explicit Guard(HeavyBuildSlots& slots_) : slots{slots_.limit != 0 ? &slots_ : nullptr} {
+            if (slots) {
+                slots->Acquire();
+            }
+        }
+        ~Guard() {
+            if (slots) {
+                slots->Release();
+            }
+        }
+        Guard(const Guard&) = delete;
+        Guard& operator=(const Guard&) = delete;
+
+    private:
+        HeavyBuildSlots* slots;
+    };
+
+    /// `limit_` slots, 0 for no limit (tests; the emulator uses Instance()).
+    explicit HeavyBuildSlots(size_t limit_) : limit{limit_} {}
+
+    static HeavyBuildSlots& Instance() {
+        static HeavyBuildSlots instance{ChooseLimit()};
+        return instance;
+    }
+
+    [[nodiscard]] size_t Limit() const noexcept {
+        return limit;
+    }
+
+    /// The default number of slots for a host with `total_ram` bytes.
+    [[nodiscard]] static constexpr size_t DefaultLimit(u64 total_ram) noexcept {
+        constexpr u64 PerBuild = u64{8} << 30;
+        return static_cast<size_t>(std::clamp<u64>(total_ram / 4 / PerBuild, 1, 8));
+    }
+
+private:
+    static size_t ChooseLimit() {
+        const size_t chosen = DefaultLimit(Common::GetMemInfo().TotalPhysicalMemory);
+        const char* const value = std::getenv("EDEN_NX2_HEAVY_BUILD_SLOTS");
+        if (value == nullptr || *value == '\0') {
+            LOG_INFO(Render_Vulkan, "Task/mesh pipeline builds: at most {} at once", chosen);
+            return chosen;
+        }
+        char* end = nullptr;
+        const long parsed = std::strtol(value, &end, 10);
+        if (end == value || *end != '\0' || parsed < 0 || parsed > 64) {
+            LOG_WARNING(Render_Vulkan,
+                        "EDEN_NX2_HEAVY_BUILD_SLOTS={} is not a number from 0 to 64, using {}",
+                        value, chosen);
+            return chosen;
+        }
+        if (parsed == 0) {
+            LOG_INFO(Render_Vulkan, "Task/mesh pipeline builds: no limit");
+        } else {
+            LOG_INFO(Render_Vulkan, "Task/mesh pipeline builds: at most {} at once", parsed);
+        }
+        return static_cast<size_t>(parsed);
+    }
+
+    void Acquire() {
+        std::unique_lock lock{mutex};
+        freed.wait(lock, [this] { return in_use < limit; });
+        ++in_use;
+    }
+
+    void Release() {
+        {
+            std::scoped_lock lock{mutex};
+            --in_use;
+        }
+        freed.notify_one();
+    }
+
+    const size_t limit;
+    std::mutex mutex;
+    std::condition_variable freed;
+    size_t in_use{};
+};
+
+} // namespace Vulkan
diff --git a/src/video_core/renderer_vulkan/nx2_list_slots.cpp b/src/video_core/renderer_vulkan/nx2_list_slots.cpp
new file mode 100644
index 0000000000..265cc42446
--- /dev/null
+++ b/src/video_core/renderer_vulkan/nx2_list_slots.cpp
@@ -0,0 +1,321 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <cstring>
+#include <utility>
+
+#include "common/logging.h"
+#include "video_core/renderer_vulkan/nx2_list_slots.h"
+#include "video_core/renderer_vulkan/vk_scheduler.h"
+#include "video_core/vulkan_common/vulkan_memory_allocator.h"
+
+namespace Vulkan {
+
+namespace Stats = Tegra::Nx2ListIndirect::Stats; // TEST
+
+namespace {
+/// TEST: the bytes of `words`.
+template <typename T, size_t Extent>
+[[nodiscard]] std::span<const u8> Bytes(std::span<T, Extent> words) {
+    return {reinterpret_cast<const u8*>(words.data()), words.size_bytes()};
+}
+} // Anonymous namespace
+
+void Nx2ListSlots::Release(u32 slot) {
+    if (slot >= SlotCount) {
+        return;
+    }
+    if (holds[slot].fetch_sub(1, std::memory_order_acq_rel) == 0) [[unlikely]] {
+        holds[slot].fetch_add(1, std::memory_order_relaxed);
+        LOG_ERROR(Render_Vulkan, "Nx2 list slot {} released without a hold", slot);
+    }
+}
+
+void Nx2ListSlots::Snapshot(VkBuffer src, u64 src_offset, u32 count, u32 slot) {
+    if (src == VK_NULL_HANDLE || slot >= SlotCount || count == 0 ||
+        count > Tegra::Nx2ListIndirect::SlotWords) {
+        return;
+    }
+    Prepare();
+    Stats::Count(Stats::Get().snapshots); // TEST
+    const VkDeviceSize base = VkDeviceSize{slot} * SlotBytes;
+    copies.clear();
+    copies.push_back(VkBufferCopy{src_offset, base, VkDeviceSize{count} * 4});
+    if (count == Tegra::Nx2ListIndirect::SlotWords) {
+        // The grid as DispatchNativeCompute takes it: height and depth are 16 bits. The upper
+        // halves of their words in the slot stay 0 from the fill (Prepare).
+        copies.push_back(VkBufferCopy{src_offset, base + DispatchOffset, 4});
+        copies.push_back(VkBufferCopy{src_offset + 4, base + DispatchOffset + 4, 2});
+        copies.push_back(VkBufferCopy{src_offset + 8, base + DispatchOffset + 8, 2});
+    }
+    RecordCopies(src, *buffer, copies);
+}
+
+void Nx2ListSlots::NoteOwed(DAddr device_addr, u32 value, u32 guest_word) {
+    // The upload wrote over older owed words at these bytes.
+    for (auto it = owed.lower_bound(device_addr >= 3 ? device_addr - 3 : 0);
+         it != owed.end() && it->first < device_addr + 4;) {
+        Release(Tegra::Nx2ListIndirect::PlaceholderSlot(it->second));
+        it = owed.erase(it);
+    }
+    if (Stats::g_check && Tegra::Nx2ListIndirect::IsPlaceholder(value)) [[unlikely]] {
+        // TEST: the upload wrote the placeholder at once (a word it did not write is not owed).
+        Stats::NoteCompared(Stats::Check::Owed, Tegra::Nx2ListIndirect::PlaceholderSlot(value),
+                            Bytes(std::span{&guest_word, 1}), Bytes(std::span{&value, 1}));
+    }
+    if (guest_word != value || !Tegra::Nx2ListIndirect::IsPlaceholder(value)) {
+        return; // It wrote nothing there
+    }
+    Stats::Count(Stats::Get().owed); // TEST
+    holds[Tegra::Nx2ListIndirect::PlaceholderSlot(value)].fetch_add(1, std::memory_order_acq_rel);
+    owed.emplace(device_addr, value);
+}
+
+void Nx2ListSlots::NoteInlineQmdGrid(DAddr device_addr, u32 x, u32 y, u32 z) {
+    std::array<u32, 3> slots{NoEntry, NoEntry, NoEntry};
+    size_t count = 0;
+    for (const u32 word : {x, y, z}) {
+        if (!Tegra::Nx2ListIndirect::IsPlaceholder(word)) {
+            continue;
+        }
+        const u32 slot = Tegra::Nx2ListIndirect::PlaceholderSlot(word);
+        if (std::ranges::find(slots, slot) == slots.end()) {
+            slots[count++] = slot;
+        }
+    }
+    if (count == 0 && qmd_slots.empty()) {
+        return;
+    }
+    // The new holds first: an old hold of the same slot is dropped after them.
+    for (size_t i = 0; i < count; ++i) {
+        holds[slots[i]].fetch_add(1, std::memory_order_acq_rel);
+    }
+    const auto it = qmd_slots.find(device_addr);
+    if (it == qmd_slots.end()) {
+        if (count != 0) {
+            qmd_slots.emplace(device_addr, slots);
+        }
+        return;
+    }
+    for (const u32 slot : it->second) {
+        if (slot != NoEntry) {
+            Release(slot);
+        }
+    }
+    if (count == 0) {
+        qmd_slots.erase(it);
+    } else {
+        it->second = slots;
+    }
+}
+
+void Nx2ListSlots::Read(std::span<const u32> slots, std::span<u32> words) {
+    std::ranges::fill(words, 0U);
+    if (!buffer) {
+        return;
+    }
+    if (!readback) {
+        readback = memory_allocator.CreateBuffer(
+            VkBufferCreateInfo{
+                .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+                .pNext = nullptr,
+                .flags = 0,
+                .size = VkDeviceSize{ReadbackSlots} * SlotWordBytes,
+                .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+                .queueFamilyIndexCount = 0,
+                .pQueueFamilyIndices = nullptr,
+            },
+            MemoryUsage::Download);
+    }
+    for (size_t first = 0; first < slots.size(); first += ReadbackSlots) {
+        const size_t count = (std::min<size_t>)(ReadbackSlots, slots.size() - first);
+        copies.clear();
+        for (size_t i = 0; i < count; ++i) {
+            copies.push_back(VkBufferCopy{VkDeviceSize{slots[first + i]} * SlotBytes,
+                                          VkDeviceSize{i} * SlotWordBytes, SlotWordBytes});
+        }
+        RecordCopies(*buffer, *readback, copies);
+        RecordHostBarrier();
+        scheduler.Finish();
+        readback.Invalidate();
+        const size_t bytes =
+            (std::min)(count * SlotWordBytes, words.size_bytes() - first * SlotWordBytes);
+        std::memcpy(words.data() + first * Tegra::Nx2ListIndirect::SlotWords,
+                    readback.Mapped().data(), bytes);
+    }
+    if (Stats::g_check) [[unlikely]] {
+        // TEST: the words read back against the list's, and what the checks copied.
+        for (size_t i = 0; i < slots.size() && (i + 1) * SlotWordBytes <= words.size_bytes(); ++i) {
+            const u32 slot = slots[i];
+            if (slot < SlotCount && check_counts[slot] != 0) {
+                const size_t known = check_counts[slot];
+                Stats::NoteCompared(
+                    Stats::Check::Read, slot,
+                    Bytes(words.subspan(i * Tegra::Nx2ListIndirect::SlotWords, known)),
+                    Bytes(std::span{check_words[slot]}.first(known)));
+            }
+        }
+        CheckFlush();
+    }
+}
+
+void Nx2ListSlots::Prepare() {
+    if (buffer) {
+        return;
+    }
+    buffer = memory_allocator.CreateBuffer(
+        VkBufferCreateInfo{
+            .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+            .pNext = nullptr,
+            .flags = 0,
+            .size = VkDeviceSize{SlotCount} * SlotBytes,
+            .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+                     VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT,
+            .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+            .queueFamilyIndexCount = 0,
+            .pQueueFamilyIndices = nullptr,
+        },
+        MemoryUsage::DeviceLocal);
+    scheduler.RequestOutsideRenderPassOperationContext();
+    scheduler.Record([dst = *buffer](vk::CommandBuffer cmdbuf) {
+        static constexpr VkMemoryBarrier WRITE_BARRIER{
+            .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+        };
+        cmdbuf.FillBuffer(dst, 0, VK_WHOLE_SIZE, 0);
+        cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT,
+                               vk::PIPELINE_STAGE_GRAPHICS_COMPUTE_TRANSFER, 0, WRITE_BARRIER);
+    });
+}
+
+void Nx2ListSlots::RecordCopies(VkBuffer src, VkBuffer dst, std::span<const VkBufferCopy> regions) {
+    static constexpr VkMemoryBarrier READ_BARRIER{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .pNext = nullptr,
+        .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
+    };
+    static constexpr VkMemoryBarrier WRITE_BARRIER{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .pNext = nullptr,
+        .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+    };
+    scheduler.RequestOutsideRenderPassOperationContext();
+    scheduler.Record([src, dst, list = std::vector<VkBufferCopy>(regions.begin(), regions.end())](
+                         vk::CommandBuffer cmdbuf) {
+        cmdbuf.PipelineBarrier(vk::PIPELINE_STAGE_GRAPHICS_COMPUTE_TRANSFER,
+                               VK_PIPELINE_STAGE_TRANSFER_BIT, 0, READ_BARRIER);
+        cmdbuf.CopyBuffer(src, dst, list);
+        cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT,
+                               vk::PIPELINE_STAGE_GRAPHICS_COMPUTE_TRANSFER, 0, WRITE_BARRIER);
+    });
+}
+
+void Nx2ListSlots::RecordHostBarrier() {
+    scheduler.Record([](vk::CommandBuffer cmdbuf) {
+        // A fence makes device writes available, not visible to the host.
+        static constexpr VkMemoryBarrier HOST_BARRIER{
+            .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+        };
+        cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0,
+                               HOST_BARRIER);
+    });
+}
+
+void Nx2ListSlots::CheckSnapshot(u32 slot, std::span<const u32> words) {
+    if (slot >= SlotCount || words.empty() || words.size() > Tegra::Nx2ListIndirect::SlotWords ||
+        !buffer) {
+        return;
+    }
+    check_words[slot] = {};
+    std::ranges::copy(words, check_words[slot].begin());
+    check_counts[slot] = static_cast<u8>(words.size());
+    CheckRecord(Stats::Check::Snapshot, slot, *buffer, VkDeviceSize{slot} * SlotBytes,
+                Bytes(words));
+    if (check_entries.size() >= CheckEntries / 2) {
+        CheckFlush(); // At the list's place on the back: between methods
+    }
+}
+
+void Nx2ListSlots::CheckDispatch(u32 slot) {
+    if (slot >= SlotCount || check_counts[slot] != Tegra::Nx2ListIndirect::SlotWords) {
+        return;
+    }
+    const auto& words = check_words[slot];
+    // The grid DispatchNativeCompute dispatches from the words (the width as the slot has it).
+    const std::array<u32, 3> grid{words[0], words[1] & 0xffff, words[2] & 0xffff};
+    if (!(grid[0] && grid[1] && grid[2])) {
+        Stats::Count(Stats::Get().empty_grids);
+    }
+    if (grid[0] >> 31) {
+        Stats::Count(Stats::Get().wide_grids);
+    }
+    CheckRecord(Stats::Check::Dispatch, slot, *buffer,
+                VkDeviceSize{slot} * SlotBytes + DispatchOffset, Bytes(std::span{grid}));
+}
+
+void Nx2ListSlots::CheckPatch(VkBuffer dst) {
+    for (size_t i = 0; i < copies.size() && i < patch_words.size(); ++i) {
+        const u32 slot = Tegra::Nx2ListIndirect::PlaceholderSlot(patch_words[i].value);
+        const u32 word = Tegra::Nx2ListIndirect::PlaceholderWord(patch_words[i].value);
+        if (slot >= SlotCount || word >= check_counts[slot]) {
+            continue;
+        }
+        const auto bytes = Bytes(std::span{&check_words[slot][word], 1})
+                               .subspan(patch_words[i].skip, copies[i].size);
+        CheckRecord(Stats::Check::Patch, slot, dst, copies[i].dstOffset, bytes);
+    }
+}
+
+void Nx2ListSlots::CheckRecord(Stats::Check check, u32 slot, VkBuffer src, VkDeviceSize src_offset,
+                               std::span<const u8> expected) {
+    if (check_entries.size() >= CheckEntries || expected.size() > CheckEntryBytes) {
+        Stats::Count(Stats::Get().unchecked);
+        return;
+    }
+    if (!check_buffer) {
+        check_buffer = memory_allocator.CreateBuffer(
+            VkBufferCreateInfo{
+                .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+                .pNext = nullptr,
+                .flags = 0,
+                .size = VkDeviceSize{CheckEntries} * CheckEntryBytes,
+                .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+                .queueFamilyIndexCount = 0,
+                .pQueueFamilyIndices = nullptr,
+            },
+            MemoryUsage::Download);
+    }
+    CheckEntry entry{check, slot, static_cast<u32>(expected.size()), {}};
+    std::memcpy(entry.expected.data(), expected.data(), expected.size());
+    const VkBufferCopy copy{src_offset, VkDeviceSize{check_entries.size()} * CheckEntryBytes,
+                            expected.size()};
+    check_entries.push_back(entry);
+    RecordCopies(src, *check_buffer, std::span{&copy, 1});
+}
+
+void Nx2ListSlots::CheckFlush() {
+    if (check_entries.empty()) {
+        return;
+    }
+    RecordHostBarrier();
+    scheduler.Finish();
+    check_buffer.Invalidate();
+    const std::span<const u8> data = std::as_const(check_buffer).Mapped();
+    for (size_t i = 0; i < check_entries.size(); ++i) {
+        const CheckEntry& entry = check_entries[i];
+        Stats::NoteCompared(entry.check, entry.slot, data.subspan(i * CheckEntryBytes, entry.bytes),
+                            std::span{entry.expected}.first(entry.bytes));
+    }
+    check_entries.clear();
+}
+
+} // namespace Vulkan
diff --git a/src/video_core/renderer_vulkan/nx2_list_slots.h b/src/video_core/renderer_vulkan/nx2_list_slots.h
new file mode 100644
index 0000000000..c9cc6d4c6d
--- /dev/null
+++ b/src/video_core/renderer_vulkan/nx2_list_slots.h
@@ -0,0 +1,205 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <map>
+#include <optional>
+#include <span>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include "common/common_types.h"
+#include "video_core/nx2_list_indirect.h"
+#include "video_core/nx2_list_indirect_stats.h"
+#include "video_core/vulkan_common/vulkan_wrapper.h"
+
+namespace Vulkan {
+
+class MemoryAllocator;
+class Scheduler;
+
+/// The split GPU thread's back's slots for GPU-written command list words the host GPU takes
+/// over (Nx2ListIndirect). A slot is SlotBytes of device-local memory: the list's words as the
+/// back found them at the list's place (the snapshot, raw), and at DispatchOffset the same three
+/// as DispatchNativeCompute takes a grid: width, height & 0xffff, depth & 0xffff (a
+/// VkDispatchIndirectCommand). Holds keep a slot from being used again: the front's while its
+/// macros' words hold the slot's placeholders, the back's while a QMD's grid or a word compute
+/// dispatches bind as constant buffer data holds them.
+///
+/// The words the front's inline uploads put placeholders in are owed words: while one holds its
+/// placeholder in guest memory, a compute dispatch that binds it as constant buffer data gets the
+/// slot word there (PatchUniform, recorded after the binding filled its buffer).
+class Nx2ListSlots {
+public:
+    static constexpr u32 SlotCount = Tegra::Nx2ListIndirect::SlotCount;
+    static constexpr u32 SlotBytes = 32;
+    static constexpr u32 DispatchOffset = 16;
+
+    explicit Nx2ListSlots(MemoryAllocator& memory_allocator_, Scheduler& scheduler_)
+        : memory_allocator{memory_allocator_}, scheduler{scheduler_} {}
+
+    /// Any thread (the front's): a slot nobody holds, held for the caller.
+    [[nodiscard]] std::optional<u32> Acquire() {
+        for (u32 i = 0; i < SlotCount; ++i) {
+            const u32 slot = (next + i) % SlotCount;
+            u32 expected = 0;
+            if (holds[slot].compare_exchange_strong(expected, 1, std::memory_order_acq_rel)) {
+                next = slot + 1;
+                return slot;
+            }
+        }
+        return std::nullopt;
+    }
+
+    /// Any thread: drops a hold of `slot`.
+    void Release(u32 slot);
+
+    [[nodiscard]] bool Held(u32 slot) const {
+        return slot < SlotCount && holds[slot].load(std::memory_order_acquire) != 0;
+    }
+
+    /// The back: records the copy of the `count` words at `src_offset` of `src` (the list's host
+    /// buffer, the copy's use of the words marked) into `slot`.
+    void Snapshot(VkBuffer src, u64 src_offset, u32 count, u32 slot);
+
+    /// The back: the word at `device_addr` was just written `value` (a placeholder) by an inline
+    /// upload; `guest_word` is what guest memory holds there now.
+    void NoteOwed(DAddr device_addr, u32 value, u32 guest_word);
+
+    /// The back: an inline QMD with grid words x, y, z was just written at `device_addr`.
+    void NoteInlineQmdGrid(DAddr device_addr, u32 x, u32 y, u32 z);
+
+    [[nodiscard]] bool HasOwed() const {
+        return !owed.empty();
+    }
+
+    /// The back, binding a compute dispatch's constant buffer [device_addr, +size) at `offset`
+    /// of `dst`, filled already: records copies of the slot words owed there over it. `read`
+    /// gives the word guest memory holds at a device address: a word that no longer holds its
+    /// placeholder is no longer owed.
+    template <typename Read>
+    void PatchUniform(DAddr device_addr, u32 size, VkBuffer dst, u64 offset, Read&& read) {
+        if (dst == VK_NULL_HANDLE || size == 0) {
+            return;
+        }
+        copies.clear();
+        patch_words.clear(); // TEST
+        const DAddr end = device_addr + size;
+        for (auto it = owed.lower_bound(device_addr >= 3 ? device_addr - 3 : 0);
+             it != owed.end() && it->first < end;) {
+            const DAddr word = it->first;
+            const u32 value = it->second;
+            if (read(word) != value) {
+                Tegra::Nx2ListIndirect::Stats::Count(
+                    Tegra::Nx2ListIndirect::Stats::Get().owed_dropped); // TEST
+                Release(Tegra::Nx2ListIndirect::PlaceholderSlot(value));
+                it = owed.erase(it);
+                continue;
+            }
+            const DAddr first = (std::max)(word, device_addr);
+            const DAddr last = (std::min)(word + 4, end);
+            if (first < last) {
+                const VkDeviceSize source =
+                    VkDeviceSize{Tegra::Nx2ListIndirect::PlaceholderSlot(value)} * SlotBytes +
+                    VkDeviceSize{Tegra::Nx2ListIndirect::PlaceholderWord(value)} * 4 +
+                    (first - word);
+                copies.push_back(
+                    VkBufferCopy{source, offset + (first - device_addr), last - first});
+                patch_words.push_back({value, static_cast<u32>(first - word)}); // TEST
+            }
+            ++it;
+        }
+        if (!copies.empty()) {
+            ++patched_binds;
+            Tegra::Nx2ListIndirect::Stats::Count(
+                Tegra::Nx2ListIndirect::Stats::Get().patched_binds); // TEST
+            RecordCopies(*buffer, dst, copies);
+            if (Tegra::Nx2ListIndirect::Stats::g_check) [[unlikely]] {
+                CheckPatch(dst);
+            }
+        }
+    }
+
+    /// The buffer and offset of `slot`'s VkDispatchIndirectCommand.
+    [[nodiscard]] std::pair<VkBuffer, VkDeviceSize> DispatchArguments(u32 slot) const {
+        return {*buffer, VkDeviceSize{slot} * SlotBytes + DispatchOffset};
+    }
+
+    /// The back: the raw words of `slots`, three each, once the host GPU wrote them (submits and
+    /// waits for it).
+    void Read(std::span<const u32> slots, std::span<u32> words);
+
+    /// Dispatches whose constant buffers got owed words.
+    [[nodiscard]] u64 PatchedBinds() const {
+        return patched_binds;
+    }
+
+    /// TEST (EDEN_NX2_LIST_INDIRECT_CHECK): the words the front read as before for the list
+    /// whose snapshot `slot` just got. What the host GPU then uses of the slot is compared with
+    /// them once it ran (CheckFlush): the snapshot, the dispatches from it, the patches.
+    void CheckSnapshot(u32 slot, std::span<const u32> words);
+    /// TEST: the dispatch from `slot` just recorded.
+    void CheckDispatch(u32 slot);
+
+private:
+    static constexpr u32 NoEntry = ~0U;
+    static constexpr u32 SlotWordBytes = Tegra::Nx2ListIndirect::SlotWords * sizeof(u32);
+    static constexpr u32 ReadbackSlots = 256;
+
+    /// The slots' buffer, created on first use, zero-filled.
+    void Prepare();
+
+    /// Records `regions` from `src` to `dst` outside a render pass, between barriers as
+    /// BufferCacheRuntime::CopyBuffer puts them: after every write and read before (a slot a copy
+    /// writes may be read by an earlier dispatch or copy), before every read and write after.
+    void RecordCopies(VkBuffer src, VkBuffer dst, std::span<const VkBufferCopy> regions);
+
+    /// Records a barrier that makes transfer writes visible to the host, after a fence wait.
+    void RecordHostBarrier();
+
+    // TEST (EDEN_NX2_LIST_INDIRECT_CHECK): copies of what the host GPU used, compared with what
+    // the old path would have used once it ran them.
+    struct CheckEntry {
+        Tegra::Nx2ListIndirect::Stats::Check check;
+        u32 slot;
+        u32 bytes;
+        std::array<u8, 12> expected;
+    };
+    struct PatchWord {
+        u32 value; ///< The owed placeholder
+        u32 skip;  ///< Bytes of it before the binding
+    };
+    static constexpr u32 CheckEntries = 1024;
+    static constexpr u32 CheckEntryBytes = 16;
+    /// Records a copy of the `expected.size()` bytes at `src_offset` of `src`, for CheckFlush.
+    void CheckRecord(Tegra::Nx2ListIndirect::Stats::Check check, u32 slot, VkBuffer src,
+                     VkDeviceSize src_offset, std::span<const u8> expected);
+    /// The patch just recorded into `dst` (copies, patch_words).
+    void CheckPatch(VkBuffer dst);
+    /// Waits for the host GPU and compares what CheckRecord copied.
+    void CheckFlush();
+
+    MemoryAllocator& memory_allocator;
+    Scheduler& scheduler;
+    vk::Buffer buffer;
+    vk::Buffer readback; ///< Read's, host-visible
+    std::array<std::atomic<u32>, SlotCount> holds{};
+    u32 next{};                                              ///< Where Acquire looks first
+    std::map<DAddr, u32> owed;                               ///< By device address (the back's)
+    std::unordered_map<DAddr, std::array<u32, 3>> qmd_slots; ///< By QMD device address
+    std::vector<VkBufferCopy> copies;
+    u64 patched_binds{};
+    // TEST (EDEN_NX2_LIST_INDIRECT_CHECK).
+    std::vector<PatchWord> patch_words;
+    vk::Buffer check_buffer;
+    std::vector<CheckEntry> check_entries;
+    std::array<std::array<u32, 3>, SlotCount> check_words{};
+    std::array<u8, SlotCount> check_counts{}; ///< Words of check_words known (0: none)
+};
+
+} // namespace Vulkan
