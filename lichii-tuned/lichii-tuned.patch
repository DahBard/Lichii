diff --git a/src/shader_recompiler/translate_profile.cpp b/src/shader_recompiler/translate_profile.cpp
new file mode 100644
index 0000000000..668336ee41
--- /dev/null
+++ b/src/shader_recompiler/translate_profile.cpp
@@ -0,0 +1,84 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "shader_recompiler/translate_profile.h"
+
+#include <cstdlib>
+
+namespace Shader::TranslateProfile {
+namespace {
+
+// -1 until the first translation reads EDEN_NX2_TRANSLATE_PROFILE (Fritchii: static init runs
+// before nx2_switches.txt is applied, so the switch is read on first use).
+std::atomic<int> enabled_flag{-1};
+
+std::array<std::atomic<u64>, NumSteps> step_nanoseconds{};
+std::array<std::atomic<u64>, NumSteps> step_counts{};
+
+constexpr std::array<const char*, NumSteps> Names{
+    "CFG",
+    "BuildASL (decode and translate)",
+    "GenerateBlocks + PostOrder",
+    "RemoveUnreachableBlocks",
+    "Lower fp64/fp16/int64, barriers",
+    "SsaRewritePass",
+    "ConstantPropagationPass",
+    "PositionPass",
+    "BlitConstantsPass",
+    "GlobalMemoryToStorageBufferPass",
+    "GeometryCompactionPass",
+    "TexturePass",
+    "RescalingPass",
+    "DeadCodeEliminationPass",
+    "CollectShaderInfoPass",
+    "LayerPass",
+    "VendorWorkaroundPass",
+    "CollectInterpolationInfo",
+    "AddNVNStorageBuffers",
+    "LimitSampledTextureArrays",
+    "MergeDualVertexPrograms",
+    "ConvertLegacyToGeneric",
+    "EmitSPIRV",
+    "  SSA: visit (reads, writes)",
+    "  SSA: seal (phi operands)",
+    "  SSA: phi types and order",
+};
+
+} // Anonymous namespace
+
+const char* Name(Step step) noexcept {
+    return Names[static_cast<size_t>(step)];
+}
+
+bool Enabled() noexcept {
+    int value = enabled_flag.load(std::memory_order_relaxed);
+    if (value < 0) {
+        const char* const text = std::getenv("EDEN_NX2_TRANSLATE_PROFILE");
+        int expected = -1;
+        enabled_flag.compare_exchange_strong(expected, text != nullptr && text[0] == '1' ? 1 : 0,
+                                             std::memory_order_relaxed);
+        value = enabled_flag.load(std::memory_order_relaxed);
+    }
+    return value != 0;
+}
+
+void SetEnabled(bool enabled) noexcept {
+    enabled_flag.store(enabled ? 1 : 0, std::memory_order_relaxed);
+}
+
+void Add(Step step, std::chrono::nanoseconds time) noexcept {
+    const auto index = static_cast<size_t>(step);
+    step_nanoseconds[index].fetch_add(static_cast<u64>(time.count()), std::memory_order_relaxed);
+    step_counts[index].fetch_add(1, std::memory_order_relaxed);
+}
+
+Totals Take() noexcept {
+    Totals totals;
+    for (size_t index = 0; index < NumSteps; ++index) {
+        totals.nanoseconds[index] = step_nanoseconds[index].exchange(0, std::memory_order_relaxed);
+        totals.counts[index] = step_counts[index].exchange(0, std::memory_order_relaxed);
+    }
+    return totals;
+}
+
+} // namespace Shader::TranslateProfile
diff --git a/src/shader_recompiler/translate_profile.h b/src/shader_recompiler/translate_profile.h
new file mode 100644
index 0000000000..b093b0bc5b
--- /dev/null
+++ b/src/shader_recompiler/translate_profile.h
@@ -0,0 +1,87 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Time spent in each step of shader translation, summed over every thread, to find where a
+// pipeline's translation goes. Off unless EDEN_NX2_TRANSLATE_PROFILE=1 is set or SetEnabled is
+// called; when off a step costs one load of a flag.
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+
+#include "common/common_types.h"
+
+namespace Shader::TranslateProfile {
+
+enum class Step : u32 {
+    Cfg,
+    BuildAsl,
+    Blocks,
+    RemoveUnreachable,
+    LowerTypes,
+    SsaRewrite,
+    ConstantPropagation,
+    Position,
+    BlitConstants,
+    GlobalMemoryToStorageBuffer,
+    GeometryCompaction,
+    Texture,
+    Rescaling,
+    DeadCodeElimination,
+    CollectShaderInfo,
+    Layer,
+    VendorWorkaround,
+    Interpolation,
+    NvnStorageBuffers,
+    LimitSampledTextureArrays,
+    MergeDualVertex,
+    ConvertLegacyToGeneric,
+    EmitSpirv,
+    SsaVisit,
+    SsaSeal,
+    SsaFinal,
+    Count,
+};
+
+constexpr size_t NumSteps = static_cast<size_t>(Step::Count);
+
+[[nodiscard]] const char* Name(Step step) noexcept;
+
+[[nodiscard]] bool Enabled() noexcept;
+void SetEnabled(bool enabled) noexcept;
+
+void Add(Step step, std::chrono::nanoseconds time) noexcept;
+
+/// Totals and counts of each step since the last call, which clears them.
+struct Totals {
+    std::array<u64, NumSteps> nanoseconds{};
+    std::array<u64, NumSteps> counts{};
+};
+[[nodiscard]] Totals Take() noexcept;
+
+/// Times the enclosing scope as `step` when profiling is on.
+class Scope {
+public:
+    explicit Scope(Step step_) noexcept : step{step_}, enabled{Enabled()} {
+        if (enabled) {
+            begin = std::chrono::steady_clock::now();
+        }
+    }
+    ~Scope() {
+        if (enabled) {
+            Add(step, std::chrono::steady_clock::now() - begin);
+        }
+    }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+private:
+    Step step;
+    bool enabled;
+    std::chrono::steady_clock::time_point begin{};
+};
+
+} // namespace Shader::TranslateProfile
