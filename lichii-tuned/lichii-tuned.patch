 # Batch GPU fence syncpoints to reduce host driver overhead and smooth frametimes.
 EDEN_NX2_FENCE_BATCH=1
 
+# lichii-tuned: build every cached pipeline at boot, not only the ones recent sessions used (the
+# owner's choice, with a ~19,000-pipeline Ocarina cache; each holds ~0.45 MB of driver memory).
+# Built pipelines are kept up to a quarter of the RAM. This line overrides the "Build all cached
+# shaders before game start" checkbox; EDEN_NX2_PRELOAD_ALL_PIPELINES=0 in
+# %APPDATA%\lichii\nx2_switches.txt builds only the recent sessions' pipelines at boot.
+EDEN_NX2_PRELOAD_ALL_PIPELINES=1
+
+# lichii-tuned: on a crash, write lichii-crash-<pid>.txt (where it crashed, its call stack and the
+# loaded and unloaded modules) and lichii-crash-<pid>.dmp to %APPDATA%\lichii\crash_dumps, without
+# Windows' crash dump registry setting. Nothing runs until a crash. =0 turns it off.
+EDEN_NX2_CRASH_DUMP=1
+
 # Leave buffer downloads disabled on Switch 2 (default): forcing downloads (=1) copies back
 # 90-220 MB/s of buffers CPU never touches, causing heavy mutex contention and dropping FPS by ~38-63%.
 #EDEN_NX2_BUFFER_DOWNLOADS=1
@@ -43,3 +55,8 @@ EDEN_NX2_FENCE_BATCH=1
 #EDEN_NX2_SPLIT_SKIP=1
 #EDEN_NX2_AUTO_STUB=1
 #EDEN_NX2_KEEP_ASTC=1
+# Native task/mesh pipeline builds at once (boot, background and precache alike): each can take
+# minutes and gigabytes in the driver's compiler (Mesa's Intel driver: 150-180 s and several GB
