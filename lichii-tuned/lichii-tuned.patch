+    }
+    const auto start = Clock::now();
+    const auto hold_until = [&](Clock::time_point target) {
+        for (auto now = start; now < target && !token.stop_requested(); now = Clock::now()) {
+            const auto left = target - now;
+            if (left > std::chrono::microseconds{1500}) {
