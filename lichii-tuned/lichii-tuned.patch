+
+void ImageRecycler::Open(VmaAllocator allocator) noexcept {
+    RecyclerState& state = Recycler();
+    std::scoped_lock lock{state.mutex};
+    if (state.closed == allocator) {
+        state.closed = nullptr;
+    }
