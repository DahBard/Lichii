index 0000000000..50f5848bc0
--- /dev/null
+++ b/src/video_core/host_shaders/ocarina_hud_depth.comp
@@ -0,0 +1,38 @@
+// SPDX-FileCopyrightText: Copyright 2026 CheezyEmu contributors
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#version 450
+
+// AMD frame generation builds a coarser motion field and keeps, at each place, the motion of
+// what is nearest the camera. The HUD has the scene's depth, so the scene's motion won over the
+// HUD's (none) on its thin parts and the hearts and icons moved with the camera. Its depth copy
+// puts the HUD (the last frame's mask, widened like its motion) nearest instead.
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(binding = 0) uniform sampler2D scene_depth;
+layout(binding = 1) uniform sampler2D hud_mask;
+layout(binding = 2, r32f) uniform writeonly image2D frame_gen_depth;
+
+void main() {
+    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 extent = imageSize(frame_gen_depth);
+    if (any(greaterThanEqual(pixel, extent))) {
+        return;
+    }
+    ivec2 mask_size = textureSize(hud_mask, 0);
+    vec2 mask_scale = vec2(mask_size) / vec2(extent);
+    float hud = 0.0;
+    for (int y = -4; y <= 4; ++y) {
+        for (int x = -4; x <= 4; ++x) {
+            ivec2 at = clamp(pixel + ivec2(x, y), ivec2(0), extent - 1);
+            // The mask is at the output size; the scene can be smaller (the game's dynamic
+            // resolution, e.g. 1440x810 upscaled to 1080p): take the mask pixel at the same place.
+            ivec2 mask_at = clamp(ivec2((vec2(at) + 0.5) * mask_scale), ivec2(0), mask_size - 1);
+            hud = max(hud, texelFetch(hud_mask, mask_at, 0).r);
+        }
+    }
+    // Depth grows with distance here (not inverted): 0 is the near plane.
+    float depth = hud > 0.5 ? 0.0 : texelFetch(scene_depth, pixel, 0).r;
+    imageStore(frame_gen_depth, pixel, vec4(depth));
+}
diff --git a/src/video_core/host_shaders/ocarina_hud_mask.comp b/src/video_core/host_shaders/ocarina_hud_mask.comp
new file mode 100644
index 0000000000..a4e2c476c4
--- /dev/null
+++ b/src/video_core/host_shaders/ocarina_hud_mask.comp
@@ -0,0 +1,24 @@
+// SPDX-FileCopyrightText: Copyright 2026 CheezyEmu contributors
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#version 450
+
+// Ocarina of Time draws its HUD into FSR 4's output before the final pass scales it up. A pixel
+// that changed between FSR 4's output and the final pass is HUD.
+
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(binding = 0) uniform sampler2D before_hud;
+layout(binding = 1) uniform sampler2D after_hud;
+layout(binding = 2, r8) uniform writeonly image2D hud_mask;
+
+void main() {
+    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(pixel, imageSize(hud_mask)))) {
+        return;
+    }
+    vec4 difference = abs(texelFetch(after_hud, pixel, 0) - texelFetch(before_hud, pixel, 0));
+    float changed = max(max(difference.r, difference.g), max(difference.b, difference.a));
+    // Any change: a HUD element's soft edge or shadow changes the scene only slightly.
+    imageStore(hud_mask, pixel, vec4(changed > 0.0 ? 1.0 : 0.0));
+}
