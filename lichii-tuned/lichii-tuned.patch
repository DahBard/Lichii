+    if (end <= begin || write_blocks.empty() || latest_block_write <= Consumed()) {
+        return 0;
+    }
+    if (((end - 1) >> WriteBlockShift) - (begin >> WriteBlockShift) >= MaxWriteBlocks) {
+        return latest_block_write;
+    }
+    return BlocksPosition(write_blocks, space, begin, end);
+}
