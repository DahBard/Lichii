+            VideoCommon::EvaluateTextureHandles(
+                info, program, *gpu_memory, cbuf_address, device.GetStorageBufferAlignment(),
+                count, [&](u32 element, u32 value) {
+                    changed |= value != delta_computed_handles[index + element].value;
+                });
+            if (changed) {
