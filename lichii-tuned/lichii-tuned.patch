+                }
+                const GPUVAddr address = source + u64{i} * sizeof(u32);
+                const GPUVAddr address_end = address + sizeof(u32);
+                const auto it = fs.cb_shadow.find(*device);
+                if (it != fs.cb_shadow.end() && it->second.position > consumed &&
