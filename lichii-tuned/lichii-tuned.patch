+struct Writer {
+    std::vector<u8> bytes;
+    template <typename T>
+    void Put(const T& value) {
+        const auto* p = reinterpret_cast<const u8*>(&value);
+        bytes.insert(bytes.end(), p, p + sizeof(T));
+    }
+    void Put(Bytes data) {
+        bytes.insert(bytes.end(), data.begin(), data.end());
+    }
+    void Put(const std::vector<u8>& data) {
+        bytes.insert(bytes.end(), data.begin(), data.end());
+    }
+    void Put(const char* data, size_t n) {
+        bytes.insert(bytes.end(), reinterpret_cast<const u8*>(data),
+                     reinterpret_cast<const u8*>(data) + n);
+    }
+    void Zeros(size_t n) {
+        bytes.insert(bytes.end(), n, u8{0});
+    }
+};
+
+struct Reader {
+    Bytes bytes;
+    size_t at = 0;
+    template <typename T>
+    T Get() {
+        const T value = Load<T>(bytes, at);
+        at += sizeof(T);
+        return value;
+    }
+    Bytes Take(size_t n) {
+        if (n > bytes.size() - at) {
+            throw std::runtime_error("truncated input");
+        }
+        const auto part = bytes.subspan(at, n);
+        at += n;
+        return part;
+    }
+};
