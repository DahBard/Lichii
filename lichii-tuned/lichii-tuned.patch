+        "disabled",           "enabled",
+        "aggressive",         "efficient enabled",
+        "efficient aggressive", "aggressive at guaranteed",
+        "efficient aggressive at guaranteed"};
+    return mode < names.size() ? names[mode] : "unknown";
+}
