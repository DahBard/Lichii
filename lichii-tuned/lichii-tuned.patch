+template <class P>
+void TextureCache<P>::UnindexFramebuffer(FramebufferId framebuffer_id, const RenderTargets& key) {
+    const auto unindex_view = [this, framebuffer_id](ImageViewId view) {
+        if (!view) {
+            return;
+        }
