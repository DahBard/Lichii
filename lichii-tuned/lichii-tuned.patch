+        }
+        LOG_INFO(Render_Vulkan, "Handle table: shader {:016x} texture {}: {} elements, {} distinct:{}{}",
+                 shader, texture, tics.size(), distinct.size(), list,
+                 distinct.size() > 16 ? " ..." : "");
+    }
