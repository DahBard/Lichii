+    const auto it = maxwell3d->replace_table.find((static_cast<u64>(bank) << 32) | offset);
+    if (it == maxwell3d->replace_table.end()) {
+        return std::nullopt;
+    }
+    return ConvertReplacement(it->second);
+}
